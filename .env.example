# Copy to .env and fill in. Only the providers you run need a key.
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxx
# Jev filter (TypeSafe System One), used by `wsx filter` and `wsx query --jev`
TYPESAFE_API_KEY=
# Parallel Search (configs/parallel_fast.yaml)
PARALLEL_API_KEY=
# Luna synthesis and the judge (`wsx synth`, `wsx judge`)
OPENAI_API_KEY=
