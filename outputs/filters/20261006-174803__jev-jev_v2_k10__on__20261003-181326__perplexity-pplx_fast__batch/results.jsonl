itle": "Page Not Found", "url": "https://www.mayo.edu/research/clinical-trials/cls-20549897", "domain": "mayo.edu", "snippet": "Brain tumor, breast cancer, colon cancer, congenital heart disease, heart arrhythmia.", "date": "2013-05-02", "last_updated": "2025-01-31", "orig_rank": 9, "answers": {"on_target": 0.1, "evidence": 0.0033}, "jev_score": 0.0003, "jev_rank": 6, "kept": false, "reason": "low_on_target"}, {"rank": 5, "query_index": null, "title": "Search | AML Hub", "url": "https://aml-hub.com/search", "domain": "aml-hub.com", "snippet": "The AML Hub is an independent medical education platform, sponsored by Daiichi Sankyo, Kura Oncology, Syndax, Abbvie, Thermo Fisher and Johnson & Johnson.", "date": "2026-09-29", "last_updated": "2026-10-02", "orig_rank": 5, "answers": {"on_target": 0.02, "evidence": 0.0033}, "jev_score": 0.0001, "jev_rank": 7, "kept": false, "reason": "low_on_target"}, {"rank": 1, "query_index": null, "title": "Internal Server Error", "url": "https://cdas.cancer.gov/approved-projects/5003/", "domain": "cdas.cancer.gov", "snippet": "Please contact the server administrator at webcontacts@imsweb.com to inform them of the time this error occurred, and the actions you performed just before this error.", "date": null, "last_updated": "2024-10-20", "orig_rank": 1, "answers": {"on_target": 0.22, "evidence": 0.0}, "jev_score": 0.0, "jev_rank": 8, "kept": false, "reason": "low_on_target"}, {"rank": 4, "query_index": null, "title": "Circulars & Announcements-CStone Pharmaceuticals", "url": "https://www.cstonepharma.com/en/relation/notice15.html", "domain": "cstonepharma.com", "snippet": "Select “Accept all” for giving your consent to all cookies or select “Reject all” for using only strictly necessary cookies.", "date": "2025-01-01", "last_updated": "2025-04-19", "orig_rank": 4, "answers": {"on_target": 0.13, "evidence": 0.0}, "jev_score": 0.0, "jev_rank": 9, "kept": false, "reason": "low_on_target"}, {"rank": 10, "query_index": null, "title": "AML Intelligence", "url": "https://www.amlintelligence.com/", "domain": "amlintelligence.com", "snippet": "**AMLA has finalised three sets of regulatory technical standards (RTS) defining key measures companies and professionals must apply to reduce money laundering and terrorist financing risks.\nShaped by broad stakeholder input, the standards give the private sector a common framework for meeting these requirements, and mark a milestone towards a clear and consistent AML/CFT rulebook for the EU.**", "date": "2026-10-02", "last_updated": "2026-10-03", "orig_rank": 10, "answers": {"on_target": 0.01, "evidence": 0.0}, "jev_score": 0.0, "jev_rank": 10, "kept": false, "reason": "low_on_target"}], "total_ms": 851.3, "ts": "2026-10-06T12:18:14+00:00"}
{"case_id": "q050-batch", "row_id": "q050", "mode": "batch", "objective": "ONC201/dordaviprone in vivo monotherapy tumour growth inhibition TGI tumour regression tumour shrinkage in Pancreatic ductal adenocarcinoma animal models", "query": ["ONC201/dordaviprone PDAC monotherapy xenograft tumour growth inhibition"], "anchors": ["ONC201/dordaviprone", "ONC201", "dordaviprone"], "search_latency_ms": 439.3, "target": "ONC201/dordaviprone / ONC201 / dordaviprone", "ok": true, "error": null, "jev_latency_ms": 345.3, "calls": 10, "attempts": 10, "usage": {"input_tokens": 9971, "output_tokens": 360}, "cost_usd": 0.000419, "n_candidates": 10, "n_kept": 8, "abstain": false, "top_score": 0.6496, "results": [{"rank": 2, "query_index": null, "title": "Oncoceutics, Inc. - Drug pipelines, Patents, Clinical trials", "url": "https://synapse.patsnap.com/organization/a5bf4297675f2f507f28f8f8d99e6f95", "domain": "synapse.patsnap.com", "snippet": "02 Dec 2021·Cancer biology & therapyQ3 · MEDICINE\nCombination of ONC201 and TLY012 induces selective, synergistic apoptosis in vitro and significantly delays PDAC xenograft growth in vivo\n...\nONC201 is a potent inducer of the tumor necrosis factor related apoptosis inducing ligand (TRAIL) pathway.\n...\n*In vivo* experiments using BxPC3 and HPAFII xenograft models showed that the combination of ONC201 plus TLY012 significantly delays tumor growth as compared to controls.\n...\nONC201 inhibited tumor growth at a well-tolerated dose of 120 mg/kg/week administered by oral gavage and decreased MTC xenograft cell proliferation and angiogenesis.", "date": null, "last_updated": "2026-09-30", "orig_rank": 2, "answers": {"on_target": 0.96, "evidence": 0.6767}, "jev_score": 0.6496, "jev_rank": 1, "kept": true, "reason": "kept"}, {"rank": 5, "query_index": null, "title": "Dordaviprone/ONC201 Activation of the ClpP Mitochondrial ... - PMC", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12822620/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "**It has not yet been peer reviewed by a journal.**\n...\n# Dordaviprone/ONC201 Activation of the ClpP Mitochondrial Protease Inhibits the Growth of KRAS-Mutant Pancreatic Cancer and Overcomes RAS Inhibitor Resistance\n...\nTo identify potential combination strategies, we first assessed the ability of dordaviprone/ONC201, an FDA-approved agent, to inhibit PDAC cell and organoid growth.\nWe observed that ONC201 reduced the growth of a broad panel of KRAS-mutant PDAC cell lines, and that the expression of mitochondrial protease ClpP was required for this efficacy.\nMechanistically, we observed that treatment with ONC201 led to inhibition of mitochondrial respiration, causing a compensatory increase in glycolysis.\nFurthermore, ONC201 caused ClpP-dependent activation of PI3K-AKT-mTOR signaling and concurrent PI3K and mTOR inhibition further enhanced ONC201 growth suppression.\nONC201 demonstrated an additive effect when combined with a RAS(ON) multi-selective inhibitor RMC-7977 in PDAC cells and organoids.\nFinally, PDAC cell lines with acquired resistance to RMC-7977 or\n*KEAP1* loss-driven resistance retained sensitivity to ONC201.\nWe propose that concurrent treatment with ONC201 may delay onset of resistance to RAS inhibitor therapy.\n...\nClpP activation by dordaviprone/ONC201 suppressed PDAC cell growth and overcame resistance to the RAS(ON) multi-selective inhibitor RMC-7977, providing support for investigating this combination as a potential combination treatment for KRAS-mutant pancreatic cancer.", "date": "2025-12-03", "last_updated": "2026-02-16", "orig_rank": 5, "answers": {"on_target": 0.98, "evidence": 0.6467}, "jev_score": 0.6338, "jev_rank": 2, "kept": true, "reason": "kept"}, {"rank": 1, "query_index": null, "title": "Preclinical efficacy and mechanism of action of dordaviprone in H3 K27M-mutant diffuse glioma", "url": "https://academic.oup.com/neuro-onc-peds/article/2/3/wuag033/8750125?searchresult=1", "domain": "academic.oup.com", "snippet": "Single-agent dordaviprone inhibited tumor growth and/or improved survival in vivo in multiple H3 K27M-mutant diffuse glioma models, including intracranial, patient-derived xenografts, immune-competent, and genetically engineered mouse models.\n...\n^1^^,^^2^ In vitro experiments in cell lines and patient-derived cells have demonstrated the monotherapy efficacy of dordaviprone across hematological and solid tumors, including in tumor cells that are resistant to standard-of-care treatments.^2-6^ Dordaviprone has demonstrated tumor growth inhibition, tumor regressions, improved survival, and anti-metastatic efficacy as a single agent across a range of in vivo mouse models.\n^4^^,^^7-9^ These models include subcutaneous or orthotopic xenografts with cell lines and patient-derived tumor cells, as well as immune-competent syngeneic and genetically engineered models.^2^^,^^9^ In vitro and in vivo studies have also demonstrated synergistic or additive efficacy of dordaviprone in combination with chemotherapy, radiation, targeted therapy, and immunotherapy across a wide range of cancers.^10^", "date": "2026-07-08", "last_updated": "2026-08-07", "orig_rank": 1, "answers": {"on_target": 0.96, "evidence": 0.6267}, "jev_score": 0.6016, "jev_rank": 3, "kept": true, "reason": "kept"}, {"rank": 7, "query_index": null, "title": "Neuro-Oncology", "url": "https://pdfs.semanticscholar.org/5c2c/dd23ab60f467348b6424656052ff6b5e3248.pdf", "domain": "pdfs.semanticscholar.org", "snippet": "Remarkably, DMG patients who experienced extended benefits from dordaviprone treatment, showed reversed hallmark loss of H3K27me3, identified by IHC upon tissue autopsy, with in vitro data suggesting the mechanism to be through metabolic inhibition of the Jumonji C domain (Jmj\nC) family of histone lysine demethylases.\n...\nImportantly, dordaviprone increases levels of both NK cells and T cells, both ex- pressing PD-1, making the blockade of PD-1 an attractive approach.\nIndeed, combining 100 mg/kg dordaviprone with PD-1 inhibitors decreased tumor volume of mice orthotopically engrafted with the undifferentiated colon carcinoma cell line CT26, compared with PD-1 inhibitors\n…", "date": null, "last_updated": "2026-07-11", "orig_rank": 7, "answers": {"on_target": 0.92, "evidence": 0.64}, "jev_score": 0.5888, "jev_rank": 4, "kept": true, "reason": "kept"}, {"rank": 4, "query_index": null, "title": "Preclinical efficacy and mechanism of action of dordaviprone in H3 ...", "url": "https://academic.oup.com/neuro-onc-peds/article/2/3/wuag033/8750125", "domain": "academic.oup.com", "snippet": "Single-agent dordaviprone inhibited tumor growth and/or improved survival in vivo in multiple H3 K27M-mutant diffuse glioma models, including intracranial, patient-derived xenografts, immune-competent, and genetically engineered mouse models.\n...\n^1^^,^^2^ In vitro experiments in cell lines and patient-derived cells have demonstrated the monotherapy efficacy of dordaviprone across hematological and solid tumors, including in tumor cells that are resistant to standard-of-care treatments.^2-6^ Dordaviprone has demonstrated tumor growth inhibition, tumor regressions, improved survival, and anti-metastatic efficacy as a single agent across a range of in vivo mouse models.\n^4^^,^^7-9^ These models include subcutaneous or orthotopic xenografts with cell lines and patient-derived tumor cells, as well as immune-competent syngeneic and genetically engineered models.^2^^,^^9^ In vitro and in vivo studies have also demonstrated synergistic or additive efficacy of dordaviprone in combination with chemotherapy, radiation, targeted therapy, and immunotherapy across a wide range of cancers.^10^\n...\nSingle-agent dordaviprone has shown inhibition of tumor growth and improved survival in multiple in vivo preclinical mouse models, including intracranial, PDXs, immune-competent, and genetic mouse models (Figure 3, Table S1).\n...\nSingle-agent dordaviprone has consistently shown inhibition of tumor growth and/or improved survival in several in vivo preclinical mouse models of H3 K27M-mutant diffuse glioma, including intracranial, patient-derived xenografts, immune-competent, and genetic mouse models.", "date": "2026-07-08", "last_updated": "2026-09-30", "orig_rank": 4, "answers": {"on_target": 0.95, "evidence": 0.6167}, "jev_score": 0.5859, "jev_rank": 5, "kept": true, "reason": "kept"}, {"rank": 3, "query_index": null, "title": "29", "url": "https://touchoncology.com/wp-content/uploads/sites/2/2026/04/6.-touchONCOLOGY-D-26-00002_Review_Ozer_29-34.pdf", "domain": "touchoncology.com", "snippet": "ONC201 sensitized cancer cells to mTOR (mechanistic target of rapomycin) inhibition, a downstream effector of PI3K/AKT, leading to increased TRAIL receptor DR5 expression, as well as activation of caspase-­8.12 These effects were at least partly reversible when the TRAIL receptor was sequestered, caspase-­8 activation was inhibited, or when mTOR was degraded.10 Experimental and computational approaches confirmed that ONC201 synergizes with MAPK and AKT inhibition.13,14\n...\nDRD2 activity.19 Radioligand binding studies subsequently demonstrated that ONC201 antagonizes DRD2 via allosteric changes at concentrations needed for anti-­proliferative effects and in a dopamine-­independent manner.21,22\nThe downstream consequences are several-­fold.\nFirst, ONC201 disrupts \nDRD2 receptor engagement with scaffolding proteins, such as beta-­ arrestin, which inhibits pro-­proliferative MAPK and PI3K/AKT signalling pathways, as well as a metabolic reprogramming that suppresses glycolysis and oxidative phosphorylation.21,23,24 Second, because DRD2 normally suppresses adenylyl cyclase levels, ONC201 raises cyclic adenosine monophosphate (cAMP) levels and leads to increases in pro-­ apoptotic, cAMP-­responsive factors, including activating transcription factor 4 (ATF4) and C/EBP homologous protein (CHOP).21 Finally,\n...\nFinally, inhibition of glycolysis and/or glucose restriction might also exacerbate the ISR in combination with imipridone therapy.38 Finally, although imipridones are known to activate TRAIL without themselves being TRAIL ligands, the addition of TLY012 (a chemically modified TRAIL receptor agonist) to imipridone therapy in vitro and in patient-­derived xenograft (PDX) models appears to amplify caspase cleavage and cell death.59\n...\nONC201 and TLY012 induces selective, synergistic \napoptosis in vitro and significantly delays PDAC xenograft growth in vivo.\nCancer Biol Ther.\n2021;22:607–18.\nDOI: \n10.1080/15384047.2021.1976567.", "date": null, "last_updated": "2026-08-19", "orig_rank": 3, "answers": {"on_target": 0.94, "evidence": 0.6067}, "jev_score": 0.5703, "jev_rank": 6, "kept": true, "reason": "kept"}, {"rank": 6, "query_index": null, "title": "dordaviprone (ONC201)", "url": "https://drughunter.com/molecule/dordaviprone-onc201", "domain": "drughunter.com", "snippet": "A first-in-class, oral, brain-penetrant imipridone, dordaviprone combines mitochondrial ClpP hyperactivation with D2R antagonism, dual mechanisms implicated in anti-tumor activity across glioma models.", "date": "2025-10-10", "last_updated": "2026-09-26", "orig_rank": 6, "answers": {"on_target": 0.98, "evidence": 0.56}, "jev_score": 0.5488, "jev_rank": 7, "kept": true, "reason": "kept"}, {"rank": 10, "query_index": null, "title": "A review of current therapeutics targeting the mitochondrial protease ClpP in diffuse midline glioma, H3 K27-altered", "url": "https://academic.oup.com/neuro-oncology/article/26/Supplement_2/S136/7243676", "domain": "academic.oup.com", "snippet": "Key Points\n...\n- In DMG, dordaviprone is an agonist of the mitochondrial protease ClpP.\n...\nFor the most part, DMG clinical trials examined the dordaviprone safety and efficacy profile without the establishment of robust preclinical data for its use, including no in vivo DMG orthotopic xenograft studies, or understanding of its cellular target.\n...\nIndeed, the initial MOA reported by Allen et al., in colon cancer suggested dordaviprone promotes TRAIL-mediated apoptosis independent of p53, leading to inhibition MAPK/ERK and PI3K/Akt signaling.^26^\n...\nHistone deacetylases (HDACs), enzymatically remove acetyl groups, regulating gene expression across many different cancer types.\nNguyen et al., showed HDAC inhibition with either panobinostat and romidepsin-induced synthetic lethality when combined with imipridones which suppressed tumor cell metabolism in glioblastoma cells.\n...\nEmploying a proteogenomic profiling approach, exposure to dordaviprone in DMG cells increased mitochondrial oxidative stress that was seen to promote redox activation of PI3K/Akt signaling, resulting in metabolic adaption and cell survival.\n...\nDordaviprone’s potential role in the promotion of immune cell infiltration into the TME suggests it might be effectively combined with ICIs.\nImportantly, dordaviprone increases levels of both NK cells and T cells, both expressing PD-1, making the blockade of PD-1 an attractive approach.\nIndeed, combining 100 mg/kg dordaviprone with PD-1 inhibitors decreased tumor volume of mice orthotopically engrafted with the undifferentiated colon carcinoma cell line CT26, compared with PD-1 inhibitors alone.^74^ However, the effect was not seen with lower doses of dordaviprone or in mice with chemically induced murine colon adenocarcinoma cells MC38 pressing the need for DMG studies investigating the efficacy of combining dordaviprone with ICIs.", "date": "2024-05-03", "last_updated": "2026-09-30", "orig_rank": 10, "answers": {"on_target": 0.93, "evidence": 0.59}, "jev_score": 0.5487, "jev_rank": 8, "kept": true, "reason": "kept"}, {"rank": 9, "query_index": null, "title": "ONC201 (Dordaviprone) in Recurrent H3 K27M-Mutant Diffuse ...", "url": "https://pubmed.ncbi.nlm.nih.gov/38335473/", "domain": "pubmed.ncbi.nlm.nih.gov", "snippet": "** Histone 3 (H3) K27M-mutant diffuse midline glioma (DMG) has a dismal prognosis with no established effective therapy beyond radiation. This integrated analysis evaluated single-agent ONC201 (dordaviprone), a first-in-class imipridone, in recurrent H3 K27M-mutant DMG.\n**\n...\n** Fifty patients (pediatric, n = 4; adult, n = 46) with recurrent H3 K27M-mutant DMG who received oral ONC201 monotherapy in four clinical trials or one expanded access protocol were included. Eligible patients had measurable disease by Response Assessment in Neuro-Oncology (RANO) high-grade glioma (HGG) criteria and performance score (PS) ≥60 and were ≥90 days from radiation; pontine and spinal tumors were ineligible.\nThe primary end point was overall response rate (ORR) by RANO-HGG criteria. Secondary end points included duration of response (DOR), time to response (TTR), corticosteroid response, PS response, and ORR by RANO low-grade glioma (LGG) criteria. Radiographic end points were assessed by dual-reader, blinded independent central review.\n...\n** The ORR (RANO-HGG) was 20.0% (95% CI, 10.0 to 33.7). The median TTR was 8.3 months (range, 1.9-15.9); the median DOR was 11.2 months (95% CI, 3.8 to not reached).\nThe ORR by combined RANO-HGG/LGG criteria was 30.0% (95% CI, 17.9 to 44.6). A ≥50% corticosteroid dose reduction occurred in 7 of 15 evaluable patients (46.7% [95% CI, 21.3 to 73.4]); PS improvement occurred in 6 of 34 evaluable patients (20.6% [95% CI, 8.7 to 37.9]).\nGrade 3 treatment-related treatment-emergent adverse events (TR-TEAEs) occurred in 20.0% of patients; the most common was fatigue (n = 5; 10%); no grade 4 TR-TEAEs, deaths, or discontinuations occurred.\n**\nConclusion:\n** ONC201 monotherapy was well tolerated and exhibited durable and clinically meaningful efficacy in recurrent H3 K27M-mutant DMG.", "date": "2024-01-05", "last_updated": "2026-09-19", "orig_rank": 9, "answers": {"on_target": 0.96, "evidence": 0.4467}, "jev_score": 0.4288, "jev_rank": 9, "kept": false, "reason": "low_evidence"}, {"rank": 8, "query_index": null, "title": "dordaviprone - NCI Drug Dictionary - National Cancer Institute", "url": "https://www.cancer.gov/publications/dictionaries/cancer-drug/def/dordaviprone", "domain": "cancer.gov", "snippet": "A water soluble, orally bioavailable inhibitor of the serine/threonine protein kinase Akt (protein kinase B) and extracellular signal-regulated kinase (ERK), with potential antineoplastic activity.\nUpon administration, dordaviprone binds to and inhibits the activity of Akt and ERK, which may result in inhibition of the phosphatidylinositol 3-kinase (PI3K)/Akt signal transduction pathway as well as the mitogen-activated protein kinase (MAPK)/ERK-mediated pathway.\nThis may lead to the induction of tumor cell apoptosis mediated by tumor necrosis factor (TNF)-related apoptosis-inducing ligand (TRAIL)/TRAIL death receptor type 5 (DR5) signaling in AKT/ERK-overexpressing tumor cells.\nThe PI3K/Akt signaling pathway and MAPK/ERK pathway are upregulated in a variety of tumor cell types and play a key role in tumor cell proliferation, differentiation and survival by inhibiting apoptosis.", "date": "2011-02-02", "last_updated": "2025-10-26", "orig_rank": 8, "answers": {"on_target": 0.91, "evidence": 0.4233}, "jev_score": 0.3852, "jev_rank": 10, "kept": false, "reason": "low_evidence"}], "total_ms": 784.6, "ts": "2026-10-06T12:18:15+00:00"}
{"case_id": "q053-batch", "row_id": "q053", "mode": "batch", "objective": "ADT-1004 in vivo single-agent monotherapy tumour growth inhibition TGI tumour regression or shrinkage in Pancreatic ductal adenocarcinoma animal models", "query": ["ADT-1004 quantitative tumour growth inhibition percentage PDAC monotherapy", "ADT-1004 tumour regression percentage MIA PaCa-2 xenograft", "ADT-1004 KRAS G12D PDX tumour shrinkage monotherapy", "ADT-1004 KPC orthotopic tumour volume change day 27", "ADT-1004 MIA-AMG-R xenograft final tumour volume monotherapy"], "anchors": ["ADT-1004"], "search_latency_ms": 629.8, "target": "ADT-1004", "ok": true, "error": null, "jev_latency_ms": 338.7, "calls": 10, "attempts": 10, "usage": {"input_tokens": 9485, "output_tokens": 360}, "cost_usd": 0.000398, "n_candidates": 10, "n_kept": 10, "abstain": false, "top_score": 0.9151, "results": [{"rank": 7, "query_index": null, "title": "Abstract 7236: Selective deletion of the KRAS mutant gene with ADGN-123 and ADGN-121 peptide-RNA nanoparticles: A new strategy to overcome acquired resistance to KRASG12C and KRASG12D small molecule inhibitors", "url": "https://bohrium.dp.tech/paper/arxiv/ffee0d817592d670e297e4ab211cf142a28ff61c465334c6c900b42f135d3637", "domain": "bohrium.dp.tech", "snippet": "In a mouse clinical trial with KRASG12D xenograft tumor models, RMC-9805 administered orally as a single agent was well tolerated and induced objective responses in 7 of 9 PDAC PDX and CDX models and 6 of 9 NSCLC PDX models, as assessed by mRECIST.\n...\nOverall, RMC-9805 monotherapy elicited tumor regressions in most preclinical PDAC and NSCLC cancer models harboring KRASG12D.\n...\nResults: ADT-1004, a prodrug of ADT-007 that exhibits potent inhibitory effects on the proliferation of both human and murine RAS mutant PDAC cell lines with single-digit nM IC50 values, compared with μM IC50 in PDAC cells with WT RAS, was well tolerated in mice at a dose up to 175 mg/kg bid orally with sustained plasma levels of ADT-007 that exceeded IC50 values by 50-fold and even higher concentrations in pancreatic tumors.\nWhen administered orally at 40mg/kg body weight, ADT-1004 resulted in substantial growth inhibition of the KRAS-G12D and KRAS-G12V tumors, leading to profound tumor regression without any accompanying loss in body weight.\nADT-1004 also displayed a significant inhibitory effect on ERK phosphorylation.\nNotably, this inhibition is effective regardless of the specific RAS mutational codon or isozyme, as it specifically targets activated RAS and disrupts downstream KRAS signaling pathways.\nConclusion: These results highlight the promise of ADT-1004 as a potential breakthrough for treating PDAC.\nThis novel pan-RAS inhibitor demonstrates potent inhibition of PDAC growth, irrespective of the specific KRAS mutation.", "date": "2024-03-31", "last_updated": "2025-06-04", "orig_rank": 7, "answers": {"on_target": 0.95, "evidence": 0.9633}, "jev_score": 0.9151, "jev_rank": 1, "kept": true, "reason": "kept"}, {"rank": 1, "query_index": null, "title": "ADT-1004: a first-in-class, oral pan-RAS inhibitor with robust ...", "url": "https://link.springer.com/article/10.1186/s12943-025-02288-9?error=cookies_not_supported&code=d921b7d0-2285-448c-af48-bb748e5ce2b0", "domain": "link.springer.com", "snippet": "ADT-1004 potently blocked tumor growth and RAS activation in mouse PDAC models without discernable toxicity with target engagement and reduced activated RAS and ERK phosphorylation.\nIn addition, ADT-1004 suppressed tumor growth in PDX PDAC models with KRAS^G12D^, KRAS^G12V^, KRAS^G12C^, or KRAS^G13Q^ mutations and increased CD4^+^ and CD8^+^ T cells in the TME consistent with exhaustion and increased MHCII^+^ M1 macrophage and dendritic cells.\n...\nADT-1004 has strong antitumor activity in aggressive and clinically relevant PDAC models with unique selectivity to block RAS-mediated signaling in RAS mutant cells.\n...\nMost mice in the ADT-1004 treatment groups displayed reduced bioluminescence compared with mice treated with vehicle.\nDoses of ADT-1004 from 20 to 50 mg/kg demonstrated comparable statistically significant reductions in tumor weights compared to vehicle-treated mice or mice treated with 10 mg/kg ADT-1004 (Fig. 1G).\n...\nSimilar to results from the first experiment, oral administration of ADT-1004 at a dosage of 40 mg/kg demonstrated a significant reduction in tumor growth compared with the vehicle group, as evidenced by the bioluminescence imaging and tumor weight without differences in body weight (Fig. 2A-E).\n...\nADT-1004 treatment significantly inhibited the growth of PDAC tumors with KRAS^G12D^ (Fig. 5A and C, Supplementary Fig. 5A), KRAS^G12C^ (Fig. 5E and G, Supplementary Fig. 5B), KRAS^G12V^ (Fig.\n...\nThese results lead us to conclude that ADT-1004 selectively inhibits RAS-dependent tumor growth in mouse tumor PDAC models and are consistent with previous reports characterizing the in vitro growth inhibitory activity of ADT-1004 [14].\n...\nMIA PaCa-2 KRAS^G12C^ cells showed remarkable sensitivity to ADT-007 with an IC~50~ value of 3 nM, while sotorasib and adagrasib were less potent with IC~50~ values of 28 and 21 nM, respectively (Fig.\n...\nNext, experiments utilizing NSG mice xenografted subcutaneously with parental MIA PaCa-2 and MIA-AMG-R cells were conducted.\nMice implanted with parental MIA PaCa-2 cells showed comparable decreased tumor volume (Fig. 7E) and final tumor weights (Fig. 7F and G), following treatment with ADT-1004, sotorasib or adagrasib, each at a once-daily dose of 40 mg/kg (5x/week).\n...\nIn this study, we show that human MIA PaCa-2 PDAC cells harboring KRAS^G12C^ developed to be resistant to sotorasib and adagrasib retained sensitivity to ADT-007 in vitro and to ADT-1004 in vivo.", "date": "2025-03-13", "last_updated": "2026-09-09", "orig_rank": 1, "answers": {"on_target": 0.99, "evidence": 0.9133}, "jev_score": 0.9042, "jev_rank": 2, "kept": true, "reason": "kept"}, {"rank": 2, "query_index": null, "title": "ADT-1004: a first-in-class, oral pan-RAS inhibitor with ... - PubMed", "url": "https://pubmed.ncbi.nlm.nih.gov/40082968/?fc=20250217093552&ff=20250316024649&v=2.18.0.post9+e462414", "domain": "pubmed.ncbi.nlm.nih.gov", "snippet": "** Murine PDAC cells with KRAS^G12D^ mutation (KPC-luc or 2838c3-luc) were orthotopically implanted into the pancreas of C57BL/6J mice, and four PDX PDAC tumors with KRAS mutations were implanted subcutaneously in NSG mice.\n...\n** ADT-1004 potently blocked tumor growth and RAS activation in mouse PDAC models without discernable toxicity with target engagement and reduced activated RAS and ERK phosphorylation.\nIn addition, ADT-1004 suppressed tumor growth in PDX PDAC models with KRAS^G12D^, KRAS^G12V^, KRAS^G12C^, or KRAS^G13Q^ mutations and increased CD4^+^ and CD8^+^ T cells in the TME consistent with exhaustion and increased MHCII^+^ M1 macrophage and dendritic cells.\nADT-1004 demonstrated superior efficacy over sotorasib and adagrasib in tumor models resistant to these KRAS^G12C^ inhibitors and MRTX1133 resistant KRAS^G12D^ mutant cells.\nAs evidence of selectivity for tumors with mutant KRAS, ADT-1004 did not impact the growth of tumors from RAS^WT^ PDAC cells.\n...\n** ADT-1004 has strong antitumor activity in aggressive and clinically relevant PDAC models with unique selectivity to block RAS-mediated signaling in RAS mutant cells.\nAs a pan-RAS inhibitor, ADT-1004 has broad activity and potential efficacy advantages over allele-specific KRAS inhibitors.\nThese findings support clinical trials of ADT-1004 for KRAS mutant PDAC.", "date": "2025-03-13", "last_updated": "2026-05-18", "orig_rank": 2, "answers": {"on_target": 0.99, "evidence": 0.89}, "jev_score": 0.8811, "jev_rank": 3, "kept": true, "reason": "kept"}, {"rank": 6, "query_index": null, "title": "Pan-RAS Inhibitors: Expanding Therapeutic Potential and Evading Resistance", "url": "https://www.mdpi.com/2072-6694/18/11/1844", "domain": "mdpi.com", "snippet": "To overcome first-pass metabolism, an orally bioavailable prodrug of ADT-007, ADT-1004, was developed.\n...\nIn murine models of RAS-driven PDAC, ADT-1004 demonstrated robust and durable antitumor activity at well-tolerated doses.\nOral dosing maintained therapeutic plasma levels of ADT-007 and produced significant tumor growth inhibition, which correlated with reduced activated RAS levels and ERK signaling [62].\nADT-1004 was effective in PDX models of pancreatic cancer harboring KRAS mutations (G12D, G12V, G12C, and G13Q) but did not affect the growth of tumors established from the WT RAS BxPC3 pancreatic tumor cell line, which is driven by a downstream BRAF mutation.\n...\nOral administration of ERAS-4001 in mice achieved dose-dependent plasma exposure, reduced P-ERK levels, and produced antitumor activity, including 77% tumor growth inhibition in KRAS G12D xenograft models and tumor regression in G12V xenograft models [80].\n...\n|pan-RAS|ADT-1004|Preclinical [62]|", "date": "2026-06-04", "last_updated": "2026-08-13", "orig_rank": 6, "answers": {"on_target": 0.98, "evidence": 0.8467}, "jev_score": 0.8298, "jev_rank": 4, "kept": true, "reason": "kept"}, {"rank": 9, "query_index": null, "title": "A potent and selective pan-RAS inhibitor, ADT-1004, targeting complex KRAS mutations for pancreatic cancer.", "url": "https://ascopubs.org/doi/10.1200/JCO.2024.42.23_suppl.90", "domain": "ascopubs.org", "snippet": "When administered orally at 40 mg/kg body weight, ADT-1004 displayed robust antitumor activity in mouse tumor models using patient or mouse derived PDAC cell lines with G12D, G12V, G12C, or G13Q KRAS mutations, causing significant inhibitory effects on ERK phosphorylation.\n**Conclusions:**ADT-1004 inhibited tumor growth of KRAS mutant PDA tumors by targeting activated RAS to disrupt downstream MAPK/AKT signaling.", "date": "2024-08-10", "last_updated": "2025-03-03", "orig_rank": 9, "answers": {"on_target": 0.99, "evidence": 0.78}, "jev_score": 0.7722, "jev_rank": 5, "kept": true, "reason": "kept"}, {"rank": 10, "query_index": null, "title": "Abstract LB_B26: Efficacy and tolerability of a novel pan-RAS inhibitor with a unique mechanism of selectivity in mouse models of pancreatic cancer", "url": "https://aacrjournals.org/mct/article/22/12_Supplement/LB_B26/730805/Abstract-LB-B26-Efficacy-and-tolerability-of-a", "domain": "aacrjournals.org", "snippet": "ADT-007 inhibits PDAC cell growth\n*in vitro* with IC 50 as low as 2 nM regardless of RAS mutant allele, inhibits RAS activation, and downstream MAPK/AKT signaling.\n...\nDaily oral ADT-1004 administration results in significant inhibiteion of tumor growth in both mouse orthotopic and PDX models of PDAC tumors accompanied by a reduction in RAS signaling.", "date": null, "last_updated": "2025-11-03", "orig_rank": 10, "answers": {"on_target": 0.94, "evidence": 0.8133}, "jev_score": 0.7645, "jev_rank": 6, "kept": true, "reason": "kept"}, {"rank": 5, "query_index": null, "title": "Key Considerations for Targeting KRAS in Pancreatic Cancer - PMC", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13037533/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "|ADT-1004/007|Pan-RAS inhibitor|Preclinical|Significant tumor suppression in KRAS G12D orthotopic and PDX models; activity across G12D, G12V, G12C, G12Q; increases CD4+/CD8+ infiltration; superior to G12C inhibitors in resistant models|\n...\nADT-007 and its orally bioavailable prodrug ADT-1004 is a pan-RAS inhibitor currently under clinical investigation in PDAC and other RAS-driven cancers, with superior efficacy over sotorasib and adagrasib in tumor resistant models.45,46 AMG-410 is a non-covalent,", "date": "2026-03-27", "last_updated": "2026-09-29", "orig_rank": 5, "answers": {"on_target": 0.96, "evidence": 0.7733}, "jev_score": 0.7424, "jev_rank": 7, "kept": true, "reason": "kept"}, {"rank": 4, "query_index": null, "title": "Adt-1004: A First-in-Class, Orally Bioavailable Selective ...", "url": "https://augusta.elsevierpure.com/en/publications/adt-1004-a-first-in-class-orally-bioavailable-selective-pan-ras-i/fingerprints/", "domain": "augusta.elsevierpure.com", "snippet": "### Keyphrases\n- Tumor 100%\n...\n- Pancreatic Ductal Adenocarcinoma 100%\n...\n- PDAC Cells 75%\n- Tumor Growth 50%\n- Antitumor Activity 50%\n...\n- Pancreas Adenocarcinoma 100%\n- Tumor Growth 66%", "date": null, "last_updated": "2026-09-30", "orig_rank": 4, "answers": {"on_target": 0.96, "evidence": 0.72}, "jev_score": 0.6912, "jev_rank": 8, "kept": true, "reason": "kept"}, {"rank": 8, "query_index": null, "title": "Emerging KRAS G12D inhibitor in the treatment of digestive ...", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13066353/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "In concert, these mechanisms demonstrate that durable responses with MRTX1133 monotherapy are unlikely.\n...\nADT-1004 has been reported as a first-in-class, orally available pan-RAS inhibitor with robust antitumor activity in preclinical models of PDAC, representing an alternative modality that emphasizes broader RAS pathway suppression (91).", "date": "2026-03-20", "last_updated": "2026-10-01", "orig_rank": 8, "answers": {"on_target": 0.94, "evidence": 0.65}, "jev_score": 0.611, "jev_rank": 9, "kept": true, "reason": "kept"}, {"rank": 3, "query_index": null, "title": "Kras G12d", "url": "https://www.tandfonline.com/doi/full/10.2147/DDDT.S559325", "domain": "tandfonline.com", "snippet": "Early clinical trials of targeted therapies have shown encouraging results, including tumor shrinkage and disease control in some patients.\n...\nPreliminary results presented at ASCO 2025 from the G12D–mutant PDAC cohort (40 evaluable patients) demonstrated encouraging antitumor activity, with an ORR of approximately 30% and disease control achieved in 80% of patients.^Citation36^ Pharmacodynamic analyses showed on-target activity, including reductions in *KRAS* G12D circulating tumor DNA (ctDNA) in responding patients.\n...\nEarly dose-escalation cohorts have demonstrated preliminary antitumor activity, and preclinical studies suggest synergistic effects when combined with proteasome inhibition with carfilzomib.^Citation37^ TSN1611 targets both GTP-bound (active) and GDP-bound (inactive) G12D and has demonstrated good tolerability with preliminary tumor shrinkage in refractory G12D–mutant tumors, including PDAC, non-small cell lung cancer, and colorectal cancer, in early phase I/II studies (NCT06385925).^Citation38^\n...\nMultiple other pan-RAS candidates are advancing in parallel.\nADT-007 and its orally bioavailable prodrug ADT-1004 is a pan-RAS inhibitor currently under clinical investigation in PDAC and other RAS-driven cancers, with superior efficacy over sotorasib and adagrasib in tumor resistant models.", "date": "2026-03-27", "last_updated": "2026-07-06", "orig_rank": 3, "answers": {"on_target": 0.83, "evidence": 0.6333}, "jev_score": 0.5256, "jev_rank": 10, "kept": true, "reason": "kept"}], "total_ms": 968.5, "ts": "2026-10-06T12:18:15+00:00"}
{"case_id": "q051-batch", "row_id": "q051", "mode": "batch", "objective": "DWP216 in vivo monotherapy tumour growth inhibition TGI tumour regression tumour shrinkage in KRAS G12C Pancreatic Ductal Adenocarcinoma animal models", "query": ["DWP216 KRAS G12C pancreatic ductal adenocarcinoma monotherapy xenograft tumour growth inhibition regression"], "anchors": ["DWP216"], "search_latency_ms": 1047.8, "target": "DWP216", "ok": true, "error": null, "jev_latency_ms": 376.6, "calls": 10, "attempts": 10, "usage": {"input_tokens": 9297, "output_tokens": 360}, "cost_usd": 0.00039, "n_candidates": 10, "n_kept": 0, "abstain": true, "top_score": 0.1269, "results": [{"rank": 5, "query_index": null, "title": "KRAS Inhibition in Pancreatic Ductal Adenocarcinoma - PMC - NIH", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12842425/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "This drug has been further investigated in clinical trials across xenograft models of KRAS G12D mutant cancer.\nThis drug has also been investigated in 9 patients with PDAC.\nThis study showed that oral administration of Zoldonrasib at 100 mg/kg was well tolerated and that tumor regression was observed when it was combined with a MAPK pathway inhibitor.\n...\nRMC 6236 in phase 1 clinical trial elicited an objective response rate (ORR) of 20% and a disease control rate of 87% in PDAC.", "date": "2026-01-21", "last_updated": "2026-09-27", "orig_rank": 5, "answers": {"on_target": 0.27, "evidence": 0.47}, "jev_score": 0.1269, "jev_rank": 1, "kept": false, "reason": "low_on_target"}, {"rank": 7, "query_index": null, "title": "Direct GDP-KRASG12C inhibitors and mechanisms of resistance: the tip of the iceberg - Joshua C. Rosen, Adrian Sacher, Ming-Sound Tsao, 2023", "url": "https://journals.sagepub.com/doi/10.1177/17588359231160141", "domain": "journals.sagepub.com", "snippet": "*In vivo*, sotorasib led to maximal inhibition of p-ERK 2–4 h after treatment which was sustained for 48 h, and cell-derived xenografts regressed over 3 weeks of treatment.\n...\n#### D-1553\n76Activity was observed in NSCLC and PDAC cell-derived xenografts, and combinations with a MEKi, SHP2i, or other cytotoxic agents led to tumor regression.", "date": "2023-03-10", "last_updated": "2025-04-10", "orig_rank": 7, "answers": {"on_target": 0.15, "evidence": 0.35}, "jev_score": 0.0525, "jev_rank": 2, "kept": false, "reason": "low_on_target"}, {"rank": 2, "query_index": null, "title": "KRAS G12C Inhibitors: Clinical Progress, Resistance Mechanisms ...", "url": "https://www.noah.bio/insight/b8ec81a6-15df-415b-8981-2cf19f47a6e0", "domain": "noah.bio", "snippet": "|Olomorasib (prior KRAS G12Ci)|LOXO-RAS-20001|I/II|Prior-KRAS G12C inhibitor NSCLC|41–42|NR|8.1–8.2|NR|No grade ≥3 in toxicity-related discontinuations|\n...\nIn PDAC specifically, KRAS G12C monotherapy with adagrasib or sotorasib has shown ORRs of approximately 21–33% and PFS of 4.0–5.4 months—meaningful but inferior to NSCLC—likely reflecting a dense immunosuppressive stroma and high prevalence of pre-existing resistance alterations (16.4–36.4% of KRAS G12C PDAC cases) 24252829.", "date": null, "last_updated": "2026-09-26", "orig_rank": 2, "answers": {"on_target": 0.15, "evidence": 0.2867}, "jev_score": 0.043, "jev_rank": 3, "kept": false, "reason": "low_on_target"}, {"rank": 9, "query_index": null, "title": "Targeting KRAS in PDAC: A New Way to Cure It?", "url": "https://www.mdpi.com/2072-6694/14/20/4982", "domain": "mdpi.com", "snippet": "Another KRAS^G12C^ inhibitor, MRTX849, validated its antitumor activity against KRAS^G12C^ mutation-containing tumors in a mouse xenograft model [72].\n...\nIn a previous study, MRTX1133 achieved excellent results in a mouse xenograft model of pancreatic cancer, with a 94% reduction in tumor volume at 3 mg/kg BID (IP) compared to the control group [13].\n...\nNSC48160 inhibited the survival and growth of KRAS-driven pancreatic cancer cells CPFAC-1 (KRAS^G12V^) and BxPC-3 (wild-type KRAS) by using MTT and colony-forming assays [16].\n...\nAdditionally, the combined targeting of KRAS^G12C^ with cell cycle checkpoints or immune checkpoints is promising [50,72,117]; the triple combined inhibition of KRAS^G12C^/SHP2/PD-L1 leads to severe tumor regression in PDAC mouse models [108].\n...\n|NCT05375994|Study of VS-6766 + Adagrasib in KRAS G12C NSCLC Patients (RAMP204)|1/2|MRTX849 VS-6766|KRAS^G12C^ RAF/MEK|", "date": "2022-10-11", "last_updated": "2026-08-13", "orig_rank": 9, "answers": {"on_target": 0.15, "evidence": 0.2767}, "jev_score": 0.0415, "jev_rank": 4, "kept": false, "reason": "low_on_target"}, {"rank": 6, "query_index": null, "title": "Frontiers | Evaluation of KRAS inhibitor-directed therapies for pancreatic cancer treatment", "url": "https://www.frontiersin.org/journals/oncology/articles/10.3389/fonc.2024.1402128/full", "domain": "frontiersin.org", "snippet": "Several studies have shown that in mouse models, ablation of mutant KRAS in established tumors promotes PDAC regression (27, 28, 45), emphasizing the promising therapeutic potential for KRAS-directed inhibitors.\n...\nA confirmed partial response was seen in 21% of the patients, with an 84% disease control rate (DCR).\nThe median progression-free survival and overall survival were 4.0 and 6.9 months, respectively.\nIn the KRYSTAL-1 trial, adagrasib was evaluated in 21 patients with unresectable or metastatic PDAC harboring KRAS^G12C^ mutations (102).\nA partial response was seen in 33% of the patients, with a 100% DCR, and the median progression-free survival and overall survival were 5.4 and 8.0 months, respectively.", "date": "2024-05-10", "last_updated": "2026-05-19", "orig_rank": 6, "answers": {"on_target": 0.1, "evidence": 0.3}, "jev_score": 0.03, "jev_rank": 5, "kept": false, "reason": "low_on_target"}, {"rank": 10, "query_index": null, "title": "Broad-Spectrum RAS Inhibition in Pancreatic Ductal Adenocarcinoma: Mechanistic Advances and Therapeutic Promise", "url": "https://www.mdpi.com/1424-8247/18/12/1788", "domain": "mdpi.com", "snippet": "Preclinical studies show these agents induce deep tumor regressions, overcome resistance to allele-specific inhibitors, and remodel the tumor microenvironment (TME) by enhancing T-cell infiltration and reducing immunosuppressive myeloid cells.\n...\n|ADT-007|Preclinical (PDAC and CRC cell lines; xenografts)|—|Preclinical|Compared with KRAS G12C inhibitors in vitro and in vivo|Potent RAS-GTP suppression; induced apoptosis and G2/M arrest; tumor regression in PDAC PDX models|Limited solubility and rapid clearance prompted the ADT-1004 design|[41,48]|\n...\nIn patients with PDAC, the Disease Control Rate (DCR) and Objective Response Rate (ORR) were 87% and 20%, respectively [47].\n...\nOral administration of ADT-1004 demonstrated significant antitumor activity across multiple PDAC models, comprising orthotopically implanted murine cell lines and patient-derived xenografts (PDXs) possessing various KRAS mutations.\n...\nADT-007 entirely suppressed colony formation in KRAS^G12C^ PDAC cells, surpassing the efficacy of sotorasib, adagrasib, the KRAS-specific inhibitor BI-2865, and the pan-RAS inhibitor RMC-6236.", "date": "2025-11-24", "last_updated": "2026-08-12", "orig_rank": 10, "answers": {"on_target": 0.1, "evidence": 0.2867}, "jev_score": 0.0287, "jev_rank": 6, "kept": false, "reason": "low_on_target"}, {"rank": 1, "query_index": null, "title": "Modeling response to the KRAS-G12C inhibitor AZD4625 in KRAS G12C NSCLC patient-derived xenografts reveals insights into primary resistance mechanisms", "url": "https://www.nature.com/articles/s41416-025-03216-w", "domain": "nature.com", "snippet": "To ensure reproducibility of G12Ci sensitivity in vivo, NCI-H358 cell-derived xenografts were treated with AZD4625, which led to stable disease (Supplemental Fig. S1D).\nAlso, the PDX PHLC207 was treated with AZD4625 or sotorasib for 4 weeks (Fig. 1e).\nBoth monotherapies led to similar tumour regression and both compounds were well tolerated by mice, suggesting similar antitumor efficacy.\nAZD4625 monotherapy is sensitising in subset of KRAS G12C PDX models\n...\nPHLC82, PHLC151, PHLC194 and PHLC207 regressed on AZD4625 treatment (had a rate of change in tumour volume below 1, meaning volume was decreasing) and were categorised as AZD4625-sensitive, while the remaining eight models that continued to grow on AZD4625 were classified as AZD4625-resistant (Fig. 2a).\n...\nThrough a 1 month-long drug monotherapy treatment regimen, tumour regression occurred in 4/12 (33.3%) of our tumour models.", "date": "2025-10-11", "last_updated": "2025-10-11", "orig_rank": 1, "answers": {"on_target": 0.12, "evidence": 0.23}, "jev_score": 0.0276, "jev_rank": 7, "kept": false, "reason": "low_on_target"}, {"rank": 3, "query_index": null, "title": "Targeting KRAS in pancreatic cancer - PMC - NIH", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11055996/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "First data demonstrated significant activity in PDAC, with 6/8 patients exhibiting stable disease and three showing a 30% reduction at 4.3 months median follow-up [33].\n...\nMRTX1133 exhibits single-digit nanomolar activity in cellular tests, suppresses KRAS G12D signaling and it showed high antitumor activity in murine animal models [40].\nIn detail, this inhibitor showed tumor regression >30% in 73% (8/11) of KRAS G12D-mutated PDAC cell lines and patient-derived xenografts (PDX) [40].\n...\nTH-Z835 has been demonstrated to suppress MAPK signaling and cell proliferation as well as growth of xenografts in models of pancreatic cancer and additionally shows synergy with an anti-PD-1 checkpoint antibody.\n...\nTo date, 65 patients with PDAC have been enrolled in the trial’s dose-escalation phase of RMC-6236, with tumors harboring variants other than KRAS G12C.\nG12D in never smokers made up 35% of this group.\nIn the PDAC cohort, the Overall Response Rate (ORR) was 20% and the Disease Control Rate (DCR) was 87% among 46 evaluable patients.\n...\nFirst data from a dose escalation trial employing BI-1701963 as monotherapy showed good tolerability and stable disease up to 18 weeks in 7/31 patients with KRAS mutated solid tumors [65].", "date": "2024-04-23", "last_updated": "2026-09-30", "orig_rank": 3, "answers": {"on_target": 0.11, "evidence": 0.2267}, "jev_score": 0.0249, "jev_rank": 8, "kept": false, "reason": "low_on_target"}, {"rank": 8, "query_index": null, "title": "KRAS inhibitors: resistance drivers and combinatorial strategies", "url": "https://www.cell.com/trends/cancer/fulltext/S2405-8033(24)00275-9", "domain": "cell.com", "snippet": "Similar to RMC-7977, preclinical models treated with RMC-6236 tolerated all doses tested and induced strong tumor regression in both PDAC and NSCLC models.", "date": "2025-02-01", "last_updated": "2025-08-12", "orig_rank": 8, "answers": {"on_target": 0.06, "evidence": 0.2333}, "jev_score": 0.014, "jev_rank": 9, "kept": false, "reason": "low_on_target"}, {"rank": 4, "query_index": null, "title": "Kras G12d", "url": "https://www.tandfonline.com/doi/full/10.2147/DDDT.S559325", "domain": "tandfonline.com", "snippet": "In the Phase 1/2 CodeBreaK 100 study, which primarily enrolled heavily pretreated patients, sotorasib demonstrated a median PFS of 4.0 months and median OS of 6.9 months in *KRAS* G12C–mutant PDAC, with an objective response rate (ORR) of approximately 21%.\n...\nPreliminary results presented at ASCO 2025 from the G12D–mutant PDAC cohort (40 evaluable patients) demonstrated encouraging antitumor activity, with an ORR of approximately 30% and disease control achieved in 80% of patients.^Citation36^ Pharmacodynamic analyses showed on-target activity, including reductions in *KRAS* G12D circulating tumor DNA (ctDNA) in responding patients.\n...\nProof-of-concept for *KRAS*-targeted cellular therapy was demonstrated by Leidner et al, who reported regression of metastatic PDAC following adoptive transfer of autologous T cells engineered to recognize *KRAS* G12D presented by *HLA-C* *08:02.\n...\nDaraxonrasib (RMC-6236) is a multi-selective RAS(ON) inhibitor that targets active RAS independent of the specific mutant allele.\nUpdated phase 1 data in previously treated metastatic KRAS G12X-mutated PDAC show encouraging clinical activity, with ORRs of 36% at 300 mg versus 27% in patients with broader RAS mutations, and 29% versus 25% across the 160–300 mg dose range.\n^Citation44^ Disease control was seen in 91–95% across groups and doses.\nMedian PFS was 8.5 months and median OS 14.5 months, exceeding historical benchmarks for second-line chemotherapy.\n...\nIn orthotopic *KRAS* G12D pancreatic tumors, AAV8-delivered CasRx guided by mutation-specific sgRNAs effectively suppressed mutant *KRAS* expression, abrogated downstream signaling, and significantly prolonged survival without detectable toxicity.^Citation67^ These effects extended to patient-derived xenografts, where CasRx treatment inhibited tumor growth and enhanced sensitivity to gemcitabine ().\n...\nWhile allele-specific inhibitors targeting G12C, G12D, and G12V, as well as pan-RAS(ON) agents, have shown promising activity in preclinical models and early-phase trials, clinical responses remain limited and variable.", "date": "2026-03-27", "last_updated": "2026-07-06", "orig_rank": 4, "answers": {"on_target": 0.06, "evidence": 0.2033}, "jev_score": 0.0122, "jev_rank": 10, "kept": false, "reason": "low_on_target"}], "total_ms": 1424.4, "ts": "2026-10-06T12:18:15+00:00"}
{"case_id": "q052-batch", "row_id": "q052", "mode": "batch", "objective": "HM100714 in vivo efficacy in combination with another agent in Head and Neck Squamous Cell Carcinoma, including the combination partner", "query": ["HM100714 HNSCC combination in vivo efficacy", "HM100714 head and neck squamous cell carcinoma xenograft combination", "HM100714 combination partner xenograft", "HM100714 AACR HNSCC combination", "HM100714 cisplatin or pembrolizumab HNSCC"], "anchors": ["HM100714"], "search_latency_ms": 1096.4, "target": "HM100714", "ok": true, "error": null, "jev_latency_ms": 341.9, "calls": 10, "attempts": 10, "usage": {"input_tokens": 8839, "output_tokens": 360}, "cost_usd": 0.000371, "n_candidates": 10, "n_kept": 2, "abstain": false, "top_score": 0.6208, "results": [{"rank": 2, "query_index": null, "title": "“비만 넘어 항암으로 혁신 확장”…한미, AACR서 차세대 신약 대거 공개", "url": "https://www.hanmi.co.kr/about/news-media/press/detail-4042.hm", "domain": "hanmi.co.kr", "snippet": "HM100714는 HER2 변이 암에서 강력한 항암 효능과 함께 낮은 EGFR(표피 성장인자 수용체) 관련 독성을 바탕으로, 엔허투 내성 이종이식 마우스 모델에서 항종양 활성이 확인됐고, 뇌 및 연수막 전이 모델에서도 우수한 효능과 양호한 안전성 프로파일을 나타냈다.", "date": "2026-04-28", "last_updated": "2026-09-30", "orig_rank": 2, "answers": {"on_target": 0.96, "evidence": 0.6467}, "jev_score": 0.6208, "jev_rank": 1, "kept": true, "reason": "kept"}, {"rank": 5, "query_index": null, "title": "Hanmi Showcases Next Generation Drug Innovations at AACR", "url": "https://www.hanmipharm.com/about/investor-relations/press/detail-4164.hm", "domain": "hanmipharm.com", "snippet": "HM100714 demonstrated robust antitumor efficacy in HER2-mutant cancers along with low EGFR (epidermal growth factor receptor)-related toxicity, confirming antitumor activity in an Enhertu-resistant xenograft mouse model; it also showed strong efficacy and a favorable safety profile in brain and leptomeningeal metastasis models.", "date": "2026-04-28", "last_updated": "2026-09-22", "orig_rank": 5, "answers": {"on_target": 0.97, "evidence": 0.6333}, "jev_score": 0.6143, "jev_rank": 2, "kept": true, "reason": "kept"}, {"rank": 6, "query_index": null, "title": "1744602650044.docx", "url": "https://hanmi.co.kr/file/admin/pressRelease/1744602650044.docx", "domain": "hanmi.co.kr", "snippet": "또 한미약품은 HER2 변이암에 대한 경구용 치료제로 개발 중인 ‘선택적 HER2 저해제(HM100714)’의 중추신경계 종양에 대한 항암 효력과 엔허투 내성 극복에 대한 연구 결과를 공개한다.", "date": null, "last_updated": "2025-04-16", "orig_rank": 6, "answers": {"on_target": 0.95, "evidence": 0.4767}, "jev_score": 0.4529, "jev_rank": 3, "kept": false, "reason": "low_evidence"}, {"rank": 1, "query_index": null, "title": "Hanmi Records Highest Number of AACR Presentations ...", "url": "https://hanmipharm.com/about/investor-relations/press/detail-3962.hm", "domain": "hanmipharm.com", "snippet": "The company will also unveil research on its oral targeted therapy candidate, the selective HER2 inhibitor (HM100714), which is under development to treat HER2-mutant cancers.", "date": "2026-04-06", "last_updated": "2026-08-24", "orig_rank": 1, "answers": {"on_target": 0.93, "evidence": 0.39}, "jev_score": 0.3627, "jev_rank": 4, "kept": false, "reason": "low_evidence"}, {"rank": 10, "query_index": null, "title": "Frontiers | Head and neck cancer – emerging targeted therapies", "url": "https://www.frontiersin.org/journals/oncology/articles/10.3389/fonc.2025.1640960/full", "domain": "frontiersin.org", "snippet": "*In vivo* studies using xenograft models demonstrated that SI-B001, when used as a monotherapy, is more effective than cetuximab in inhibiting tumor growth.\nFurthermore, when SI-B001 was combined with carboplatin and paclitaxel in xenograft models, it produced a synergistic antitumor effect that surpassed the results of cetuximab used alongside the same agents (68).", "date": "2025-09-11", "last_updated": "2026-09-30", "orig_rank": 10, "answers": {"on_target": 0.15, "evidence": 0.28}, "jev_score": 0.042, "jev_rank": 5, "kept": false, "reason": "low_on_target"}, {"rank": 8, "query_index": null, "title": "FDA Approves Pembrolizumab for First-Line Treatment ...", "url": "https://www.ons.org/publications-research/voice/news-views/06-2019/fda-approves-pembrolizumab-first-line-treatment", "domain": "ons.org", "snippet": "On June 10, 2019, the U.S. Food and Drug Administration (FDA) approved pembrolizumab (Keytruda^®^) for the first-line treatment of patients with metastatic or unresectable recurrent head and neck squamous cell carcinoma (HNSCC).\nPembrolizumab was approved for use in combination with platinum and fluorouracil (FU) for all patients and as a single agent for patients whose tumors express PD‑L1 (Combined Positive Score [CPS] ≥ 1) as determined by an FDA‑approved test.\n...\nApproval was based on KEYNOTE-048 (NCT02358031), a randomized, multicenter, three-arm, open‑label, active‑controlled trial conducted in 882 patients with metastatic HNSCC who had not previously received systemic therapy for metastatic disease or with recurrent disease who were considered incurable by local therapies.\nPatients were randomized (1:1:1) to receive one of the following treatments: pembrolizumab as a single agent; pembrolizumab, carboplatin or cisplatin, and FU; or cetuximab, carboplatin or cisplatin, and FU.\n...\nOverall survival (OS), sequentially tested in the subgroup of patients with CPS ≥ 20 HNSCC, the subgroup of patients with CPS ≥ 1 HNSCC and the overall population, was the major efficacy measure.\nThe trial demonstrated a statistically significant improvement in OS in the overall population for patients randomized to pembrolizumab plus chemotherapy compared with cetuximab plus chemotherapy at a pre-specified interim analysis.\nThe median OS was 13.0 months for the pembrolizumab plus chemotherapy arm and 10.7 months for the cetuximab plus chemotherapy arm (HR 0.77; 95% CI: 0.63, 0.93; p = 0.0067).\nResults were similar in the CPS ≥20 subgroup (HR 0.69; 95% CI: 0.51, 0.94) and CPS ≥ 1 subgroup (HR 0.71; 95% CI: 0.57, 0.88).\nThe trial also demonstrated statistically significant improvements in OS for the subgroups of patients with PD‑L1 CPS ≥ 1 HNSCC and PD-L1 CPS ≥ 20 HNSCC randomized to pembrolizumab as a single agent compared with cetuximab plus chemotherapy.\nIn the CPS ≥ 1 subgroup, the median OS was 12.3 months for the pembrolizumab arm and 10.3 months for the cetuximab plus chemotherapy arm (HR 0.78; 95% CI: 0.64, 0.96; p = 0.0171).\nFor the CPS ≥ 20 subgroup, the median OS was 14.9 months for the pembrolizumab arm and 10.7 months for the cetuximab plus chemotherapy arm (HR 0.61; 95% CI: 0.45, 0.83; p = 0.0015).\nAt the time of the interim analysis, there was no significant difference in OS between the pembrolizumab as a single agent arm and the cetuximab plus chemotherapy arm for the overall population.\nThere were no significant differences in progression-free survival for either pembrolizumab-containing arm compared to the cetuximab plus chemotherapy arm in any population.", "date": "2019-06-11", "last_updated": "2026-10-02", "orig_rank": 8, "answers": {"on_target": 0.12, "evidence": 0.1933}, "jev_score": 0.0232, "jev_rank": 6, "kept": false, "reason": "low_on_target"}, {"rank": 4, "query_index": null, "title": "Real-world use of first-line pembrolizumab + platinum + ...", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10881782/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "The programmed death-1 (PD-1) immune checkpoint inhibitor pembrolizumab is currently approved in the US for the first-line (1L) treatment of recurrent or metastatic head and neck squamous cell carcinoma (R/M HNSCC), either alone or in combination with platinum and 5-fluorouracil (5-FU).\n...\nThe rwOS and other real-world outcomes observed for this study population further support pembrolizumab + platinum + taxane combination therapy as a potential 1L treatment option for R/M HNSCC.\n...\nIn the registration clinical trial (KEYNOTE-048), pembrolizumab + platinum + 5-FU was associated with longer OS compared with cetuximab + platinum + 5-FU in all individuals (median OS: 13.0 versus 10.7 months), while pembrolizumab monotherapy\nwas associated with longer OS compared with cetuximab + platinum + 5-FU in individuals with a combined positive score (CPS, a measure of programmed death ligand-1 [PD-L1] expression in tumor and infiltrating immune cells) of ≥1 (12.3 versus 10.3 months in the CPS ≥1 group and 14.9 versus 10.7 months for the CPS ≥20 group) (8).\n...\nThe 2024 NCCN ^1^ Clinical Practice Guidelines in Oncology (NCCN Guidelines^®^) for Head and Neck Cancers list pembrolizumab + platinum (cisplatin or carboplatin) + 5-FU as a category 1 option for 1L treatment of R/M HNSCC, with pembrolizumab monotherapy as a category 1 option for tumors that express PD-L1 with CPS ≥1 (11).\n...\nPembrolizumab in combination with cisplatin or carboplatin plus paclitaxel or docetaxel is currently listed as a category 2A option for 1L treatment of R/M HNSCC in the NCCN Guidelines^®^ (11), and thus is already available in the US.\n...\nThe median (95% CI) rwOS was 14.9 (8.8–23.3) months, with an OS rate of 53.2% at 12 months and 31.4% at 24 months.\n...\nIn conclusion, the rwOS, rwToT, and rwTTNT for 1L pembrolizumab + platinum + taxane observed in this real-world outcome analysis provide support for this regimen as a potential 1L combination therapy option for R/M HNSCC.", "date": "2024-02-08", "last_updated": "2026-01-12", "orig_rank": 4, "answers": {"on_target": 0.07, "evidence": 0.1433}, "jev_score": 0.01, "jev_rank": 7, "kept": false, "reason": "low_on_target"}, {"rank": 7, "query_index": null, "title": "ASCO Publishes New Guideline on Immunotherapy, Biomarker Testing in Advanced Head and Neck Cancer", "url": "https://dailynews.ascopubs.org/do/asco-publishes-new-guideline-immunotherapy-biomarker-testing-advanced-head-and-neck", "domain": "dailynews.ascopubs.org", "snippet": "First-line therapy options for patients with a CPS ≥ 1 include pembrolizumab as either monotherapy or in combination with platinum and 5-FU.\nFirst-line options for patients with a CPS < 1 include pembrolizumab, platinum, and 5-FU.\nFor patients with platinum-refractory recurrent or metastatic HNSCC, pembrolizumab or nivolumab may be considered, regardless of CPS status.\nFor patients with recurrent or metastatic nasopharyngeal cancer, recommended first-line options include toripalimab, camrelizumab, and tislelizumab, each with gemcitabine and cisplatin.\nIf those immune checkpoint inhibitors are not available, pembrolizumab or nivolumab may be used with gemcitabine and cisplatin.", "date": "2022-12-16", "last_updated": "2025-04-03", "orig_rank": 7, "answers": {"on_target": 0.05, "evidence": 0.1667}, "jev_score": 0.0083, "jev_rank": 8, "kept": false, "reason": "low_on_target"}, {"rank": 9, "query_index": null, "title": "Efficacy and safety of the neoadjuvant chemoimmunotherapy with ...", "url": "https://www.frontiersin.org/journals/immunology/articles/10.3389/fimmu.2025.1664892/full", "domain": "frontiersin.org", "snippet": "This study aimed to evaluate the efficacy and safety of neoadjuvant chemoimmunotherapy with pembrolizumab plus docetaxel and cisplatin in patients with resectable locally advanced HNSCC.\n...\nThis was a prospective single-center, single-arm, open-label, phase II study involving patients with locally advanced HNSCC who were treated with pembrolizumab (200 mg) plus docetaxel (50 mg/m^2^) and cisplatin (50 mg/m^2^).\nAfter two cycles of the neoadjuvant chemoimmunotherapy, patients either proceeded to surgery or refused surgery and continued with chemoimmunotherapy and/or chemoradiotherapy.\n...\nOverall, 52 patients with HNSCC were enrolled (45 males/7 females), with a median age of 61 years.\nThe ORR rate was 87.8% (95% confidence interval [CI]: 75.2–95.4).\nOf the 27 patients who underwent resection, 12 (44.4%, 95% CI: 25.5–64.7) achieved a pCR and 15 (55.6%, 95% CI: 35.3–74.5) achieved an MPR.\nFor the overall population, the PFS rates were 89.8% (95% CI: 77.2–95.6), 87.5% (95% CI: 74.2–94.2), and 72.7% (95% CI: 50.6–\n86.1), and the OS rates were 95.9% (95% CI: 84.7–99.0), 93.6% (95% CI: 81.5–97.9) and 84.9% (65.0–93.9), at 6 months, 12-months and 18 months, respectively.\n...\nPembrolizumab plus docetaxel and cisplatin reveals encouraging survival benefit with a manageable safety profile in patients with HNSCC.\n...\nAfter an evaluation using the combined positive score (CPS), the patients were treated with neoadjuvant pembrolizumab (200 mg) plus docetaxel (50 mg/m²) and cisplatin (50 mg/m²) on day 1 of each 3-week cycle, for a total of two cycles.\n...\nAfter two cycles of neoadjuvant therapy, 10 patients achieved CR (oral: n=1; oropharyngeal: n=3; hypopharyngeal: n=5; laryngeal carcinoma: n=1), 33 patients achieved PR (oral: n=6;\noropharyngeal: n=13; hypopharyngeal: n=9; laryngeal carcinoma: n=3; other: n=2), with an ORR of 87.8% (95% confidence interval [CI]: 75.2–95.4) (**Figure 2**).\n...\nThe estimated 6-month, 12-month and 18-month PFS rates were 89.8% (95% CI: 77.2–95.6), 87.5% (95% CI: 74.2–94.2) and 72.7% (95% CI: 50.6–86.1) (**Figure 4A**).\n...\nIn this prospective, single-arm phase II clinical trial, neoadjuvant chemotherapy immunotherapy with pembrolizumab plus docetaxel and cisplatin demonstrated promising efficacy and safety profile for resectable locally advanced HNSCC, with an ORR of 87.8% and generally manageable TRAEs.", "date": "2025-12-17", "last_updated": "2026-09-24", "orig_rank": 9, "answers": {"on_target": 0.06, "evidence": 0.09}, "jev_score": 0.0054, "jev_rank": 9, "kept": false, "reason": "low_on_target"}, {"rank": 3, "query_index": null, "title": "Immunotherapy and Biomarker Testing in Recurrent and Metastatic Head and Neck Cancers: ASCO Guideline", "url": "https://ascopubs.org/doi/pdfdirect/10.1200/JCO.22.02328", "domain": "ascopubs.org", "snippet": "Recommendation 2.1.\nPembrolizumab monotherapy or pembrolizumab, platinum, and fluorouracil should be offered as first- line treatment for patients with recurrent or metastatic HNSCC with a CPS $ 1 (Type: Evidence based, benefits outweigh harms; Evidence quality: High; Strength of recommendation: Strong).", "date": null, "last_updated": "2025-03-20", "orig_rank": 3, "answers": {"on_target": 0.04, "evidence": 0.11}, "jev_score": 0.0044, "jev_rank": 10, "kept": false, "reason": "low_on_target"}], "total_ms": 1438.3, "ts": "2026-10-06T12:18:15+00:00"}
{"case_id": "q049-batch", "row_id": "q049", "mode": "batch", "objective": "ABSK131 in vivo single-agent monotherapy tumour growth inhibition TGI tumour regression or shrinkage in MTAP-Deleted KRAS G12D-Mutated Pancreatic Ductal Adenocarcinoma animal models", "query": ["ABSK131 SU.86.86 monotherapy TGI", "ABSK131 PDAC xenograft monotherapy tumour regression", "ABSK131 KRAS G12D PDAC in vivo monotherapy", "ABSK131 MTAP-deleted pancreatic xenograft tumour volume"], "anchors": ["ABSK131"], "search_latency_ms": 1676.4, "target": "ABSK131", "ok": true, "error": null, "jev_latency_ms": 350.1, "calls": 10, "attempts": 10, "usage": {"input_tokens": 9040, "output_tokens": 360}, "cost_usd": 0.00038, "n_candidates": 10, "n_kept": 6, "abstain": false, "top_score": 0.673, "results": [{"rank": 2, "query_index": null, "title": "ABSK131 / Abbisko - LARVOL DELTA", "url": "https://delta.larvol.com/Products/?ProductId=77f15c4a-7852-4271-a722-b1143fb00c80", "domain": "delta.larvol.com", "snippet": "(AACR 2026)\n...\n- \"ABSK131 exhibits strong anti-tumor activity in MTAP-deleted lung and pancreatic cancer models and synergizes effectively with multiple therapeutic agents.\nThese findings support the continued clinical development of ABSK131 as both a monotherapy and in combination regimens for MTAP-deleted cancers.\"", "date": null, "last_updated": "2026-09-18", "orig_rank": 2, "answers": {"on_target": 0.98, "evidence": 0.6867}, "jev_score": 0.673, "jev_rank": 1, "kept": true, "reason": "kept"}, {"rank": 10, "query_index": null, "title": "IDE397 / Ideaya Biosci - LARVOL DELTA", "url": "https://delta.larvol.com/Products/?ProductId=4f847675-044d-4618-bfbc-99f5a8416591", "domain": "delta.larvol.com", "snippet": "## Synergistic antitumor activity of the MTA-cooperative PRMT5 inhibitor ABSK131 in combination with multiple therapeutic agents in diverse cancer models (AACR 2026) - \"In KRAS-mutant and MTAP-deleted models, ABSK131 led to robust tumor growth inhibition when combined with KRAS G12C inhibitor AMG510 or KRAS G12D inhibitor ABSK141. In EGFR-mutant and MTAP-deleted NSCLC, ABSK131 combined with osimertinib produced enhanced anti-proliferative and in vivo antitumor efficacy. ABSK131 synergizes with multiple therapeutic classes across MTAP-deleted models, providing compelling preclinical support for developing ABSK131-based combination strategies in genetically defined patient populations in clinic.\"\n...\n## The MTA-cooperative PRMT5 inhibitor ABSK131 exhibits potent activity and broad synergistic potential in MTAP-deleted cancer models (AACR 2025) - \"ABSK131 exhibits strong anti-tumor activity in MTAP-deleted lung and pancreatic cancer models and synergizes effectively with multiple therapeutic agents. These findings support the continued clinical development of ABSK131 as both a monotherapy and in combination regimens for MTAP-deleted cancers.\"", "date": null, "last_updated": "2026-09-29", "orig_rank": 10, "answers": {"on_target": 0.98, "evidence": 0.6733}, "jev_score": 0.6598, "jev_rank": 2, "kept": true, "reason": "kept"}, {"rank": 1, "query_index": null, "title": "MTA-PRMT5 - Drugs, Indications, Patents", "url": "https://synapse.patsnap.com/target/7a68e99130134dbc9048af6318b6a4c9", "domain": "synapse.patsnap.com", "snippet": "Results were shared for ABSK112 (EGFR exon20ins inhibitor), ABSK131 (PRMT5*MTA inhibitor), and ABK-KRAS-1 (pan-KRAS inhibitor), as well as results from a study investigating potential resistance mechanisms to KRAS G12C inhibitors.\n...\nOur findings establish ABSK112 as a potent, selective and CNS-penetrant HER2 inhibitor, warranting further clinical evaluation of it as a monotherapy or in combination with HER2-targeted ADCs for the treatment of HER2+ cancers with brain metastases.\n...\nTitle 3: The MTA-Cooperative PRMT5 Inhibitor ABSK131 Exhibits Potent Activity and Broad Synergistic Potential in MTAP-Deleted Cancer Models\n...\nABSK131 exhibits strong anti-tumor activity in MTAP-deleted lung and pancreatic cancer models and synergizes effectively with multiple therapeutic agents.\nThese findings support the continued clinical development of ABSK131 as both a monotherapy and in combination regimens for MTAP-deleted cancers.\n...\nTaken together, ABK-KRAS-1 exhibits broad in vitro activity against different KRAS mutations and induces dose-dependent tumor regression in KRAS mutated xenograft models.\n...\nBAY 3713372 is an investigational agent and has not been approved by any health authority for use in any country, for any indication.", "date": null, "last_updated": "2026-09-29", "orig_rank": 1, "answers": {"on_target": 0.96, "evidence": 0.6767}, "jev_score": 0.6496, "jev_rank": 3, "kept": true, "reason": "kept"}, {"rank": 8, "query_index": null, "title": "[PDF] Abbisko Cayman Limited 和譽開曼有限責任公司 - HKEXnews", "url": "https://www1.hkexnews.hk/listedco/listconews/sehk/2026/0423/2026042300109.pdf", "domain": "www1.hkexnews.hk", "snippet": "Strong in vivo efficacy: Oral administration induced deep tumor regression in multiple \nKRAS G12V xenograft models, with robust target engagement.\n...\nMTA-cooperative PRMT5 inhibitor ABSK131\nABSK131 is a potent and selective small-molecule MTA-cooperative PRMT5 inhibitor developed by Abbisko Therapeutics, targeting MTAP-deleted tumors, and is currently in clinical development.", "date": null, "last_updated": "2026-07-23", "orig_rank": 8, "answers": {"on_target": 0.96, "evidence": 0.6667}, "jev_score": 0.64, "jev_rank": 4, "kept": true, "reason": "kept"}, {"rank": 4, "query_index": null, "title": "AACR 2026 | Abbisko Therapeutics Showcases Six Research Advances Highlighting pan-KRAS, 4th Generation EGFR, and Synthetic Lethality Approaches", "url": "https://www.biospace.com/press-releases/aacr-2026-abbisko-therapeutics-showcases-six-research-advances-highlighting-pan-kras-4th-generation-egfr-and-synthetic-lethality-approaches", "domain": "biospace.com", "snippet": "**MTA-cooperative PRMT5 inhibitor ABSK131**\nABSK131 is a potent and selective small-molecule MTA-cooperative PRMT5 inhibitor developed by Abbisko Therapeutics, targeting MTAP-deleted tumors, and is currently in clinical development.", "date": "2026-04-23", "last_updated": "2026-09-24", "orig_rank": 4, "answers": {"on_target": 0.97, "evidence": 0.58}, "jev_score": 0.5626, "jev_rank": 5, "kept": true, "reason": "kept"}, {"rank": 7, "query_index": null, "title": "Abbisko Cayman Limited 和譽開曼有限責任公司", "url": "https://www.hkexnews.hk/listedco/listconews/sehk/2024/1023/2024102300933.pdf", "domain": "hkexnews.hk", "snippet": "These two research results demonstrated \nthe latest preclinical research progress of a potential best-in-class PRMT5*MTA inhibitor\nABSK131 and a potential best-in-class oral KRASG12D inhibitor ABSK141 from Abbisko \nTherapeutics pipeline.\n...\nUtilizing structural and computation-aided medicinal chemistry design, we have discovered a potential best-in-class\nMTA-cooperative PRMT5 inhibitor ABSK131 with improved potency, selectivity, and brain-penetrant ability.\n...\nABSK131, presented here by Abbisko Therapeutics, is a highly selective MTA-cooperative and brain-penetrant PRMT5 inhibitor.\nIts superior profile supports its advancement into clinical studies.\n...\nABSK141 demonstrated high binding affinity and good biochemical activity to KRASG12D in vitro.", "date": null, "last_updated": "2025-10-08", "orig_rank": 7, "answers": {"on_target": 0.95, "evidence": 0.55}, "jev_score": 0.5225, "jev_rank": 6, "kept": true, "reason": "kept"}, {"rank": 9, "query_index": null, "title": "KRAS G12D targeted therapies for pancreatic cancer - PMC - NIH", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC9749787/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "At the same time, there is still no agent that could target KRAS G12D which is the most common KRAS mutation and is found in the majority of KRAS-mutated pancreatic tumors.\nNevertheless, significant progress is now being made in the G12D space with the development of several compounds that can bind to and inhibit KRAS G12D, most notably MRTX1133.\n...\nBinding of MRTX1133 to KRAS G12D prevents downstream signaling through inhibition of nucleotide exchange and binding of downstream effector RAF1 (30).\nThis compound was shown to inhibit oncogenic KRAS signaling selectively in tumor cells (30).\nIn a xenograft mouse model, MRTX1133 was able to significantly reduce tumor growth and decrease the phosphorylation of downstream signaling molecule ERK in a dose-dependent manner (30).\nSo far, this agent remains an *in vitro* tool compound, and its clinical progress is not known.\n...\nThese inhibitors form a salt bridge with Asp12 within the switch-II pocket resulting in the inhibition of KRAS signaling in G12D mutant PDAC cell lines (31).\nThese compounds were able to bind the G12D mutant specifically, and not KRAS G12C or WT.\nThe compounds also showed *in vivo* inhibition of tumor growth in xenograft tumor mouse models (31).\n...\nWhile these agents are not yet ready for clinical development, they provide further proof of principle that several classes of G12D inhibitors could be potentially discovered as clinical anti-cancer agents.\nA tricomplex inhibitor, RMC-9805, is a novel covalent KRAS G12D inhibitor that binds KRAS in the GTP-bound state, thus termed a KRAS-G12D(ON) inhibitor (33).\n...\nRMC-9805 reacts covalently with Asp12, thereby attenuating KRAS G12D downstream signaling specifically over KRAS WT and other KRAS mutants, and it restricts tumor growth in xenograft PDAC and CRC mouse models (33).\n...\nA study identified HLA-A*11:01 to be able to present KRAS neoantigens, and then generated murine T cells that recognize G12D mutated PDAC in an HLA-A*11:01 restricted manner and could inhibit the growth of tumors *in vivo*.", "date": "2022-11-29", "last_updated": "2026-10-02", "orig_rank": 9, "answers": {"on_target": 0.11, "evidence": 0.2567}, "jev_score": 0.0282, "jev_rank": 7, "kept": false, "reason": "low_on_target"}, {"rank": 6, "query_index": null, "title": "KRAS: the Achilles' heel of pancreas cancer biology", "url": "https://www.jci.org/articles/view/191939", "domain": "jci.org", "snippet": "The first KRAS^G12D^-selective inhibitor, MRTX1133, demonstrated near 1,000-fold selectivity for inhibiting KRAS^G12D^ signaling and *KRAS^G12D^*-mutant cancer cell growth as compared with KRAS WT (130, 131).\n...\nIn contrast to MRTX1133, zoldonrasib/RMC-9805 is a covalent ON KRAS^G12D^-selective inhibitor.\nZoldonrasib, a tri-complex inhibitor with CypA, binds to KRAS^G12D^ in its\nGTP-bound state and has demonstrated promising antitumor efficacy as both monotherapy and in combination with anti-PD1 therapy in preclinical KRAS^G12D^ models, including PDAC (133).\nEarly clinical evaluation showed promising efficacy in PDAC (30% ORR) with very limited toxicity (Table 3).", "date": "2025-08-15", "last_updated": "2026-10-03", "orig_rank": 6, "answers": {"on_target": 0.09, "evidence": 0.2233}, "jev_score": 0.0201, "jev_rank": 8, "kept": false, "reason": "low_on_target"}, {"rank": 3, "query_index": null, "title": "Kras G12d", "url": "https://www.tandfonline.com/doi/full/10.2147/DDDT.S559325", "domain": "tandfonline.com", "snippet": "Preclinical models and early-phase clinical trials demonstrate meaningful antitumor activity, with emerging evidence of tumor microenvironment remodeling and delayed resistance.\n...\nThe *KRAS* G12D mutation is the most prevalent *KRAS* alteration in pancreatic cancer, making it a central focus of ongoing therapeutic development.\nZoldonrasib (RMC-9805), an oral covalent inhibitor designed to engage the active GTP-bound form of *KRAS* G12D, has also advanced into clinical testing (NCT06040541).\nPreliminary results presented at ASCO 2025 from the G12D–mutant PDAC cohort (40 evaluable patients) demonstrated encouraging antitumor activity, with an ORR of approximately 30% and disease control achieved in 80% of patients.^Citation36^ Pharmacodynamic analyses showed on-target activity, including reductions in *KRAS* G12D circulating tumor DNA (ctDNA) in responding patients.\n...\nEarly dose-escalation cohorts have demonstrated preliminary antitumor activity, and preclinical studies suggest synergistic effects when combined with proteasome inhibition with carfilzomib.^Citation37^ TSN1611 targets both GTP-bound (active) and GDP-bound (inactive) G12D and has demonstrated good tolerability with preliminary tumor shrinkage in refractory G12D–mutant tumors, including PDAC, non-small cell lung cancer, and colorectal cancer, in early phase I/II studies (NCT06385925).^Citation38^", "date": "2026-03-27", "last_updated": "2026-07-06", "orig_rank": 3, "answers": {"on_target": 0.06, "evidence": 0.2533}, "jev_score": 0.0152, "jev_rank": 9, "kept": false, "reason": "low_on_target"}, {"rank": 5, "query_index": null, "title": "Pan-cancer clinical and molecular landscape of MTAP ...", "url": "https://www.sciencedirect.com/science/article/pii/S2059702925004041", "domain": "sciencedirect.com", "snippet": "These cookies allow us to count visits and traffic sources so we can measure and improve the performance of our site.", "date": null, "last_updated": "2025-09-23", "orig_rank": 5, "answers": {"on_target": 0.07, "evidence": 0.0133}, "jev_score": 0.0009, "jev_rank": 10, "kept": false, "reason": "low_on_target"}], "total_ms": 2026.5, "ts": "2026-10-06T12:18:15+00:00"}
{"case_id": "q055-batch", "row_id": "q055", "mode": "batch", "objective": "DB-1305/Anti-PD-L1/VEGF Bispecific Antibody patients studied in Recurrent or Disseminated HNSCC (Oral Cavity/Oropharynx/Hypopharynx/Larynx), Incurable by Local Therapies trials: biomarker selection, disease severity, line of therapy, and required prior treatment", "query": ["DB-1305 recurrent metastatic HNSCC prior treatment line of therapy", "DB-1305 HNSCC PD-L1 biomarker eligibility", "DB-1305 HNSCC ECOG measurable disease inclusion criteria"], "anchors": ["DB-1305"], "search_latency_ms": 533.4, "target": "DB-1305", "ok": true, "error": null, "jev_latency_ms": 356.2, "calls": 10, "attempts": 10, "usage": {"input_tokens": 10359, "output_tokens": 360}, "cost_usd": 0.000435, "n_candidates": 10, "n_kept": 2, "abstain": false, "top_score": 0.5859, "results": [{"rank": 1, "query_index": null, "title": "DB-1311 in Combination With BNT327 or DB-1305 ...", "url": "https://www.uclahealth.org/clinical-trials/db-1311-combination-with-bnt327-or-db-1305", "domain": "uclahealth.org", "snippet": "- For HNSCC patients: Histologically or cytologically confirmed recurrent (recurrent disease that is not amendable to curative treatment with local/ or systemic therapies)/ (disseminated) HNSCC of the oral cavity, oropharynx, hypopharynx, and larynx that is considered incurable by local therapies.\n...\n- 1.\nPrior treatment with B7H3 targeted therapy.\n- Prior treatment with antibody-drug conjugate with topoisomerase inhibitor.\n...\n- Has an uncontrolled concomitant or intercurrent illness, that in the opinion of the investigator, contra-indicates trial participation, limits compliance with trial procedures or substantially increases the risk of incurring AEs.\n- Has uncontrolled or significant cardiovascular disease.\nHas clinically uncontrolled pleural effusion, ascites or pericardial effusion requiring drainage, peritoneal shunt, or cell-free concentrated ascites reinfusion therapy.\n- Has a history of (non-infectious) ILD/pneumonitis.\n- Any autoimmune, connective tissue or inflammatory disorders.\n- Has spinal cord compression or clinically active central nervous system (CNS) metastases.\n- Has unresolved toxicities from previous anticancer therapy, defined as toxicities (other than alopecia) not yet resolved to Grade ≤1 or baseline.", "date": null, "last_updated": "2026-09-28", "orig_rank": 1, "answers": {"on_target": 0.81, "evidence": 0.7233}, "jev_score": 0.5859, "jev_rank": 1, "kept": true, "reason": "kept"}, {"rank": 10, "query_index": null, "title": "Head and Neck Squamous Cell Carcinoma clinical trials at UCLA", "url": "https://ucla.clinicaltrials.researcherprofiles.org/head-and-neck-squamous-cell-carcinoma", "domain": "ucla.clinicaltrials.researcherprofiles.org", "snippet": "This study will focus on participants with HNSCC who are treatment-naive (have not received prior treatment) in the R/M setting.\n...\n- ## DB-1311 in Combination With BNT327 or DB-1305 in Advanced/Metastatic Solid Tumors\nopen to eligible people ages 18 years and up\nA Phase II, Multicenter, Open-Label Trial of DB-1311 in combination with BNT327 or DB-1305 in Participants with Advanced/Metastatic Solid Tumors\n...\n- ## FORTIFI-HN01: A Study of Ficerafusp Alfa (BCA101) or Placebo in Combination With Pembrolizumab in First-Line PD-L1-pos, R or M HNSCC\nopen to eligible people ages 18 years and up\nFicerafusp alfa is directed against two targets, Epidermal Growth Factor Receptor (EGFR) and Transforming Growth Factor beta (TGF-β).\nThis study intends to evaluate the safety and efficacy of ficerafusp alfa in combination with pembrolizumab versus placebo with pembrolizumab in 1L PD-L1-positive, recurrent or metastatic Head and Neck Squamous Cell Carcinoma (HNSCC).\n...\nAn open-label, controlled, multi-site, interventional, 2-arm, Phase II/III trial of BNT113 in combination with pembrolizumab vs pembrolizumab monotherapy as first line treatment in patients with unresectable recurrent or metastatic HPV16+ HNSCC expressing programmed cell death ligand-1 (PD-L1) with combined positive score (CPS) ≥1.", "date": "2026-09-18", "last_updated": "2026-09-30", "orig_rank": 10, "answers": {"on_target": 0.85, "evidence": 0.5233}, "jev_score": 0.4448, "jev_rank": 2, "kept": true, "reason": "kept"}, {"rank": 7, "query_index": null, "title": "UCLA Squamous Cell Carcinoma Clinical Trials — Los Angeles", "url": "https://ucla.clinicaltrials.researcherprofiles.org/squamous-cell-carcinoma", "domain": "ucla.clinicaltrials.researcherprofiles.org", "snippet": "The purpose of this study is to compare anti-tumor activity of amivantamab in addition to pembrolizumab and carboplatin versus pembrolizumab, 5-fluorouracil (FU), and platinum therapy (carboplatin or cisplatin) in participants with refractory/metastatic (R/M) head and neck squamous cell carcinoma (HNSCC).\nHNSCC is a type of cancer that develops in the head and neck regions, including the outer tissue layer of the mouth and throat.\nThis study will focus on participants with HNSCC who are treatment-naive (have not received prior treatment) in the R/M setting.\n...\n- ## DB-1311 in Combination With BNT327 or DB-1305 in Advanced/Metastatic Solid Tumors\nopen to eligible people ages 18 years and up\nA Phase II, Multicenter, Open-Label Trial of DB-1311 in combination with BNT327 or DB-1305 in Participants with Advanced/Metastatic Solid Tumors", "date": "2026-09-24", "last_updated": "2026-10-01", "orig_rank": 7, "answers": {"on_target": 0.77, "evidence": 0.4633}, "jev_score": 0.3567, "jev_rank": 3, "kept": false, "reason": "low_evidence"}, {"rank": 5, "query_index": null, "title": "Immune biomarkers for head and neck cancer - PMC", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12715102/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "These therapies have shown better outcomes in terms of overall survival (OS) and progression-free survival (PFS) relative to standard chemotherapy, with the greatest benefits observed in HNSCC cases with elevated levels of PD-L1 [7, 12].\n...\nPD-L1 level, TMB, and microsatellites are the only approved biomarkers for ICI responses [41].\nIn 2016, FDA approval was granted to two PD-1 inhibitors in patients with relapsed or metastatic HNSCC.\nThese two monoclonal antibodies were pembrolizumab and nivolumab.\n...\nFurthermore, atezolizumab and durvalumab are monoclonal antibodies targeting PD-L1.\nServing as a response biomarker, patient biomarkers disease status or clinical state are important to consider when selecting therapies against HNC.\n...\nPD-L1 expression levels could be used as biomarkers for anti-PD-L1 drugs.\nTherefore, PD-L1 is a static predictive biomarker for relapsed or metastatic HNSCC exhibiting a combined positive score (CPS) ≥ 1 [41].\nCompared with standard-of-care chemotherapy, treatment of HNSCC with pembrolizumab or nivolumab resulted in better OS.\n...\nIn KEYNOTE-012, a phase 1b clinical trial of 188 HNSCC patients, a CPS of 1 or higher was considered a significant predictor of HNSCC’s response to pembrolizumab.\nCPS-positive patients accounted for 81% of the cohort and had better ORRs, PFS, and OS than CPS-negative patients.\n...\nConsequently, following the findings of the randomized phase 3 KEYNOTE-040 trial demonstrating that the CPS demonstrated greater sensitivity than TPS at lower threshold values in predicting pembrolizumab efficacy, CPS developed as the preferred scoring method for evaluating PD-L1 expression HNSCC [119].\n...\nAccordingly, the anti-PD-1 antibodies pembrolizumab and nivolumab received FDA approval to treat HNSCC recurring after the use of platinum-based regimens.\nPembrolizumab also was approved alongside chemotherapy (platinum and fluorouracil) for all HNSCC patients and received approval as a single-agent therapy for patients PD-L1-positive patients with CPS ≥ 1 [123].\n...\nFor HNSCC that is recurring or metastatic, a CPS ≥ 1 is the FDA-approved threshold that justifies the using pembrolizumab in the first-line setting either as single agent, or alongside chemotherapy.\n...\nPD-L1 remains a key predictive biomarker, but inconsistencies in testing methods and thresholds hinder its clinical utility [42, 43, 175].\nRecent evidence suggests that analyzing PD-L1 at relapse may yield more accurate predictions than using archival samples.\n...\nCurrently, HPV status and PD-L1 CPS remain the most widely established biomarkers with direct implications for clinical decision-making in head and neck cancer.", "date": "2025-12-18", "last_updated": "2026-08-06", "orig_rank": 5, "answers": {"on_target": 0.14, "evidence": 0.3333}, "jev_score": 0.0467, "jev_rank": 4, "kept": false, "reason": "low_on_target"}, {"rank": 9, "query_index": null, "title": "Immunotherapy in recurrent/metastatic head and neck ... - PMC", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12142288/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "The immunohistochemical assessment of PD-L1 expression was initially identified as a powerful and easily accessible predictive tool, and gained its place as the current standard for patient selection, but it has clear limitations.\n...\nBefore the advent of immunotherapy, first-line treatment options included combination regimens of cytotoxic agents in combination with cetuximab, a chimeric human anti-epidermal growth factor receptor monoclonal antibody ^7,8^.\n...\nA few years later, in 2019, after the result of the KEYNOTE 048 trial ^18^ the FDA granted approval for PD-1 inhibition as first-line treatment for patients with metastatic or unresectable, recurrent HNSCC, approving pembrolizumab in combination with platinum and fluorouracil for all patients with HNSCC and pembrolizumab as a single agent for patients with HNSCC whose tumors express a PD-L1 combined positive score (CPS) ≥ 1.\nThe expression of PD-L1 on tumor cells and infiltrating immune cells is currently assessed by immunohistochemistry on formalin-fixed paraffin-embedded (FFPE) tissue to identify patients eligible for ICI therapy.\nThe CPS is calculated as the number of PD-L1 positive invasive cancer cells, lymphocytes, and macrophages, divided by the number of viable tumor cells and multiplied by 100.\n...\nIn general, tumor PD-L1 expression is associated with improved efficacy with anti-PD-1/PD-L1 therapy in R/M HNSCC, with its predictive value being enriched by the consideration of PD-L1 expression on both tumor cells and tumor-infiltrating immune cells (CPS) ^21^.\nIn particular, post hoc analysis of data from the KEYNOTE-040 trial showed CPS and TPS to have equivalent performances at a cutoff of 50, but CPS is more sensitive than TPS at a lower cutoff of ≥ 1 ^24^.\nTherefore, CPS emerged as the best scoring method and is currently recommended, with evidence pointing at the thresholds of CPS ≥20 and ≥ 1 as clinically significant, with improved overall response rate, overall survival and progression-free survival in this population when treated with ICIs ^18,19^.\n...\nConcerning the issue of the several immunohistochemical assays available for the evaluation of PD-L1, in the US pembrolizumab was approved by the FDA exclusively for patients with CPS ≥ 1 assessed with the 22C3 PharmDx assay, while in Europe EMA stated that pembrolizumab could be used as first-line treatment for R/M HNSCC in patients with CPS ≥ 1 as assessed using any validated antibody and IHC platform.\n...\nCurrently, no recommendation exists on whether PD-L1 should be preferably tested on the primary tumor, lymph node metastasis, or distant metastasis when these options are simultaneously available.\n...\nConsequently, a positive CPS should be regarded as reliable, while a negative test should prompt further investigation if feasible.\n...\nIn 2023, the American Society of Clinical Oncology (ASCO) published guidelines for immunotherapy and biomarker testing in R/M HNSCC stating that TMB testing may be performed in patients with recurrent or metastatic HNSCC when CPS is not available or in patients with rare tumors, and that TMB ≥ 10/Mb should be interpreted as high, correlating with a clinical benefit to PD-1 inhibitors ^45^.\nCurrently, no recommendation exists to test TMB in all R/M HNSCC ^21^ but according to these results, TMB is expected to play an important role in the future.\n...\nFurthermore, positivity to both PD-L1 and PD-L2 entails a better response than what is seen with PD-L1 positivity alone ^67^.", "date": "2025-05-31", "last_updated": "2026-05-05", "orig_rank": 9, "answers": {"on_target": 0.1, "evidence": 0.33}, "jev_score": 0.033, "jev_rank": 5, "kept": false, "reason": "low_on_target"}, {"rank": 3, "query_index": null, "title": "PD-L1: Test Selection Guide", "url": "https://testdirectory.questdiagnostics.com/test/test-guides/TG_PD-L1/pd-l1-test-selection-guide", "domain": "testdirectory.questdiagnostics.com", "snippet": "|HNSCC|Keytruda® (pembrolizumab),6 see test code 36260 in **Table 2** for test information|*PD-L1 testing required (companion diagnostic)*- 1st-line treatment for PD-L1+ (CPS ≥1) metastatic or unresectable recurrent disease *PD-L1 testing indicated but not required*- 1st-line treatment (combo) for metastatic or unresectable recurrent disease - Treatment for metastatic or recurrent disease with progression on or after platinum-based therapy|\n...\n|HNSCC|Opdivo® (nivolumab),8 see test code 93793 in **Table 2** for test information|*PD-L1 testing optional (complementary diagnostic)*- Treatment for recurrent or metastatic disease with progression on or after platinum-based therapy|", "date": "2026-07-12", "last_updated": "2026-07-13", "orig_rank": 3, "answers": {"on_target": 0.1, "evidence": 0.3}, "jev_score": 0.03, "jev_rank": 6, "kept": false, "reason": "low_on_target"}, {"rank": 4, "query_index": null, "title": "PD-L1 Testing in Cancer - MyPathologyReport", "url": "https://www.mypathologyreport.ca/biomarkers/pd-l1-testing-in-cancer/", "domain": "mypathologyreport.ca", "snippet": "PD-L1 testing is mandatory for all patients with advanced or metastatic non-small cell lung cancer (NSCLC) because the result directly determines first-line treatment.\n...\n- **TPS ≥ 50% (PD-L1 high).** Pembrolizumab monotherapy is approved as a first-line treatment for advanced NSCLC without actionable driver mutations (EGFR, ALK, and others) when TPS is ≥ 50%.\n...\n### Head and neck squamous cell carcinoma\nPD-L1 testing is standard for all patients with recurrent or metastatic head and neck squamous cell carcinoma (HNSCC).\nThe 22C3 assay with CPS scoring is used, and two cut-offs are clinically meaningful:\n- **CPS ≥ 1.** Pembrolizumab combined with platinum-based chemotherapy is approved for first-line treatment of recurrent/metastatic HNSCC with CPS ≥ 1, based on the KEYNOTE-048 trial.\n- **CPS ≥ 20.** Pembrolizumab monotherapy (without chemotherapy) is approved as first-line treatment for CPS ≥ 20, based on demonstrated non-inferiority to chemotherapy with a more favorable tolerability profile.\nThis higher threshold identifies patients most likely to achieve durable responses from immunotherapy alone.\n...\nIn most cancer types with established PD-L1 thresholds, particularly NSCLC with TPS ≥ 50%, HNSCC with CPS ≥ 20, and cervical cancer with CPS ≥ 1, a high result supports the use of checkpoint inhibitor monotherapy or combination therapy.", "date": null, "last_updated": "2026-09-23", "orig_rank": 4, "answers": {"on_target": 0.08, "evidence": 0.34}, "jev_score": 0.0272, "jev_rank": 7, "kept": false, "reason": "low_on_target"}, {"rank": 6, "query_index": null, "title": "Driving Progress in Recurrent and Metastatic Head and Neck Cancer", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13101959/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "Anti-programmed death 1 (PD-1) agents such as nivolumab^4^ and pembrolizumab^5,6,7^ in pretreated patients with R/M HNSCC and their subsequent incorporation in the first-line advanced-disease setting^8^, has provided clinical benefits offering durable responses in a subset of patients.\n...\nThe KEYNOTE-048 study^8^ established the use of pembrolizumab in the first-line setting, either as monotherapy (limited to patients with PD-L1 ≥ 1 expression) or in combination with platinum and 5-fluorouracil (5-FU).\nAs a result, immunotherapy was established as the core element of standard-of-care in the first-line treatment of platinum-sensitive R/M HNSCC.\n...\nSubsequently, other 5-FU free regimens based on platinum plus taxane combination with immunotherapy have also proven be beneficial in the platinum-sensitive population.\n...\nBased on available evidence, current guidelines recommend the use of immunotherapy as monotherapy in this setting^23^.\n...\nDespite biological^10^ and technical limitations, PD-L1 remains a dominant factor to guiding first-line treatment decision.\n...\nThe treatment of recurrent/metastatic head and neck squamous cell carcinoma (R/M HNSCC) remains heavily reliant on chemotherapy-based regimens.\nHowever, immunotherapy and targeted therapy approaches offer the opportunity to introduce chemotherapy-sparing strategies.\n...\nImmune checkpoint blockade with different agents such as nivolumab, pembrolizumab or toripalimab paired with EGFR inhibitors have demonstrated overall response rates (ORR) ranging from 30% to 55% in immune-naïve populations^86,87,88,89^.\n...\nPetosentamab (MCLA-158), a bispecific antibody that targets the epidermal growth factor receptor (EGFR) and the leucine-rich repeat containing G-protein-coupled receptor 5 (LGR5), currently holds two breakthrough therapy designations by the FDA for patients with R/M HNSCC who have experienced disease progression following treatment with platinum-based chemotherapy and a PD-L1/PD-1 inhibitor^91^ and also in the first-line setting in combination with pembrolizumab for patients with PD-L1 (CPS≥1)^92^.\nThe combination of petosentamab with pembrolizumab continues to be investigated in the front-line setting (NCT03526835).\n...\nBCA101 in combination with pembrolizumab in R/M HNSCC for patients who had received no previous systemic therapy in the R/M disease setting showed ORR of 46% in the whole population and 57% in th HPV- subgroup^93,94^.\nThe phase II/III FORTIFI-HN01 study (NCT06788990) is currently evaluating the combination of pembrolizumab with ficerafusp alfa (BCA101) vs placebo in the first-line setting for PD-L1-positive R/M HNSCC^95^.\n...\nPrevious data suggest that second-line treatment should be considered after IO progression in patients with HNSCC, even in cases with poor PS^98^.\n...\nSingle agent regimens such as docetaxel, fluoropidimidines or cetuximab are commonly used but offer modest benefit and often come with substantial toxicity, particularly in patients with declining performance status.", "date": "2026-07-01", "last_updated": "2026-09-30", "orig_rank": 6, "answers": {"on_target": 0.08, "evidence": 0.3267}, "jev_score": 0.0261, "jev_rank": 8, "kept": false, "reason": "low_on_target"}, {"rank": 8, "query_index": null, "title": "Immunotherapy in Recurrent/Metastatic Squamous Cell ...", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8440813/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "Prior to immunotherapy, platinum-based chemotherapy with or without cetuximab had been the standard systemic treatment for R/M HNSCC for over a decade (61).\n...\nPembrolizumab plus platinum/5-FU for all patients 2.\nPembrolizumab monotherapy for CPS ≥1|\n...\nThis led to the FDA approval in 2019 of platinum/5FU plus pembrolizumab for all patients and pembrolizumab monotherapy only for patients with a PD-L1 CPS ≥1.\n...\nIn practice, the decision to choose pembrolizumab monotherapy *versus* chemotherapy plus pembrolizumab for a patient with CPS 1-19 depends on multiple patient and disease factors, such as tumor and symptom burden, comorbidity, and performance status.\nIn patients with a PD-L1 CPS 1-19 with high tumor burden and/or significant symptoms that can tolerate chemotherapy, we favor chemotherapy plus pembrolizumab as a standard of care treatment, to maximize potential response, which can translate directly into a quality-of-life benefit.\n...\nIn summary, current frontline standard of care systemic therapy options for R/M HNSCC of the oral cavity, oropharynx, larynx, and hypopharynx include pembrolizumab monotherapy or platinum/5FU plus pembrolizumab for PD-L1 expressers by CPS or platinum/5FU plus pembrolizumab for all patients.", "date": "2021-09-01", "last_updated": "2026-05-05", "orig_rank": 8, "answers": {"on_target": 0.06, "evidence": 0.3267}, "jev_score": 0.0196, "jev_rank": 9, "kept": false, "reason": "low_on_target"}, {"rank": 2, "query_index": null, "title": "Immunotherapy and Biomarker Testing in Recurrent and Metastatic Head and Neck Cancers: ASCO Guideline", "url": "https://ascopubs.org/doi/pdfdirect/10.1200/JCO.22.02328", "domain": "ascopubs.org", "snippet": "Patients with HNSCC commonly present with locoregionally advanced disease and often receive multimodality treatments, including surgery, radiation therapy, and/or chemotherapy.\nAlthough cisplatin is the most commonly used chemotherapy, the choice of chemotherapy depends on several factors, including prior use of platinum-based chemotherapy and primary tumor site.\nRecurrent or metastatic HNSCC is typically treated with systemic therapy involving chemotherapy and/or immunotherapy.\n...\nRecommendation 2.1.\nPembrolizumab monotherapy or pembrolizumab, platinum, and fluorouracil should be offered as first- line treatment for patients with recurrent or metastatic HNSCC with a CPS $ 1 (Type: Evidence based, benefits outweigh harms; Evidence quality: High; Strength of recommendation: Strong).\nRecommendation 2.2.\nPembrolizumab, platinum, and fluorouracil may be offered as first-line treatment for patients with recurrent or metastatic HNSCC with a CPS , 1 (Type: Evidence based, benefits outweigh harms; Evidence quality: Moderate;\nStrength of recommendation: Strong).\n...\nPembrolizumab or nivolumab should be offered to patients with platinum-refractory recurrent or metastatic HNSCC, regardless of CPS status (Type: Evidence based, benefits outweigh harms; Evidence quality: High;\n...\nRecommendation 2.1.\nPembrolizumab monotherapy or pembrolizumab, platinum, and fluorouracil (5-FU) should be offered as first-line treatment for patients with recurrent or metastatic HNSCC with a CPS $ 1 (Type: Evidence based, benefits outweigh harms; Evidence quality: High;", "date": null, "last_updated": "2025-03-20", "orig_rank": 2, "answers": {"on_target": 0.05, "evidence": 0.3167}, "jev_score": 0.0158, "jev_rank": 10, "kept": false, "reason": "low_on_target"}], "total_ms": 889.6, "ts": "2026-10-06T12:18:15+00:00"}
{"case_id": "q054-batch", "row_id": "q054", "mode": "batch", "objective": "DWP216 in vivo animal models and results: cell-line xenograft (CDX), patient-derived xenograft (PDX), syngeneic, orthotopic, or genetically engineered models", "query": ["DWP216 HNSCC in vivo xenograft monotherapy", "DWP216 NCI-H1373 monotherapy tumour volume", "DWP216 pancreatic cancer PDX syngeneic orthotopic", "DWP216 CAPAN-1 xenograft monotherapy 1200 mm3", "DWP216 genetically engineered mouse model"], "anchors": ["DWP216"], "search_latency_ms": 572.0, "target": "DWP216", "ok": true, "error": null, "jev_latency_ms": 365.6, "calls": 10, "attempts": 10, "usage": {"input_tokens": 7093, "output_tokens": 360}, "cost_usd": 0.000298, "n_candidates": 10, "n_kept": 1, "abstain": false, "top_score": 0.7154, "results": [{"rank": 1, "query_index": null, "title": "[PDF] Development of DWP216, a TEAD1 selective inhibitor for NF2 ...", "url": "https://www.kddf.org/upload/files/1737437863_554b09394faaeee65d0a.pdf", "domain": "kddf.org", "snippet": "TEAD1 selective inhibitors, on the other hand, lack sufficient potency.\n• ‌\u0007In an in vivo mouse model, DWP216 is superior to a TEAD1 selective \ninhibitor, with tumor inhibition equivalent to a pan-TEAD inhibitor.", "date": null, "last_updated": "2026-03-13", "orig_rank": 1, "answers": {"on_target": 0.98, "evidence": 0.73}, "jev_score": 0.7154, "jev_rank": 1, "kept": true, "reason": "kept"}, {"rank": 4, "query_index": null, "title": "pan-TEAD inhib News", "url": "https://sigma.larvol.com/moa.php?MoaId=1032265&tab=newstrac", "domain": "sigma.larvol.com", "snippet": "In conclusion, DWP216 is a promising TEAD1 selective inhibitor for NF2 mutant tumor and may be a proper option for drug-resistance of targeted therapy.", "date": "2024-11-14", "last_updated": "2025-06-15", "orig_rank": 4, "answers": {"on_target": 0.95, "evidence": 0.4133}, "jev_score": 0.3926, "jev_rank": 2, "kept": false, "reason": "low_evidence"}, {"rank": 2, "query_index": null, "title": "Patient Derived Xenograft", "url": "https://tumor.informatics.jax.org/mtbwi/pdxSearch.do", "domain": "tumor.informatics.jax.org", "snippet": "Patient-Derived Xenografts (PDX) are generated through the engraftment and passaging of tissue or cells from a patient's tumor into an immunodeficient or humanized mouse host.\nPDX models are an in vivo platform for cancer biology research and for pre-clinical testing of cancer drug efficacy.", "date": null, "last_updated": "2026-09-24", "orig_rank": 2, "answers": {"on_target": 0.06, "evidence": 0.3267}, "jev_score": 0.0196, "jev_rank": 3, "kept": false, "reason": "low_on_target"}, {"rank": 10, "query_index": null, "title": "Pancreatic cancer PDX models - Crown Bioscience", "url": "https://www.crownbio.com/model/pdx/pancreatic-cancer", "domain": "crownbio.com", "snippet": "Patient-derived xenograft (PDX) models provide a predictive preclinical model for the evaluation of an agent’s efficacy prior to entering the clinic.\n...\nDerived directly from patient tumors and never adapted to grow *in vitro*, Patient derived xenografts reflect the heterogeneity and diversity of the human patient population.", "date": "2026-08-17", "last_updated": "2026-09-28", "orig_rank": 10, "answers": {"on_target": 0.06, "evidence": 0.2967}, "jev_score": 0.0178, "jev_rank": 4, "kept": false, "reason": "low_on_target"}, {"rank": 5, "query_index": null, "title": "Resource Page", "url": "https://www.wagnerlab.net/resource-page", "domain": "wagnerlab.net", "snippet": "This page lists genetically engineered mouse models generated and published by our team and how to obtain them from public repositories (links to repositories not shown on the mobile page).", "date": null, "last_updated": "2026-10-01", "orig_rank": 5, "answers": {"on_target": 0.09, "evidence": 0.1067}, "jev_score": 0.0096, "jev_rank": 5, "kept": false, "reason": "low_on_target"}, {"rank": 9, "query_index": null, "title": "PDC000198 - Proteomic Data Commons - National Cancer Institute", "url": "https://proteomic.datacommons.cancer.gov/pdc/study/PDC000198", "domain": "proteomic.datacommons.cancer.gov", "snippet": "Warning\n...\nThis system is provided for Government-authorized use only.\nUnauthorized or improper use of this system is prohibited and may result in disciplinary action and/or civil and criminal penalties.", "date": null, "last_updated": "2026-09-22", "orig_rank": 9, "answers": {"on_target": 0.08, "evidence": 0.0033}, "jev_score": 0.0003, "jev_rank": 6, "kept": false, "reason": "low_on_target"}, {"rank": 6, "query_index": null, "title": "{{ngMeta['og:title']}}", "url": "https://bio.tools/pdxnet_portal", "domain": "bio.tools", "snippet": "This is a development version of the registry.\nThere is no guarantee that the data entered here will be preserved in the future.", "date": null, "last_updated": "2024-10-21", "orig_rank": 6, "answers": {"on_target": 0.06, "evidence": 0.0033}, "jev_score": 0.0002, "jev_rank": 7, "kept": false, "reason": "low_on_target"}, {"rank": 7, "query_index": null, "title": "Gene search results", "url": "https://www.mousephenotype.org/data/search", "domain": "mousephenotype.org", "snippet": "Content on this site is licensed under aCreative Commons Attribution 4.0 International license", "date": "2019-05-01", "last_updated": "2025-04-02", "orig_rank": 7, "answers": {"on_target": 0.06, "evidence": 0.0033}, "jev_score": 0.0002, "jev_rank": 8, "kept": false, "reason": "low_on_target"}, {"rank": 3, "query_index": null, "title": "Internal Server Error", "url": "https://cdas.cancer.gov/approved-projects/5003/", "domain": "cdas.cancer.gov", "snippet": "The server encountered an internal error or misconfiguration and was unable to complete your request.", "date": null, "last_updated": "2024-10-20", "orig_rank": 3, "answers": {"on_target": 0.12, "evidence": 0.0}, "jev_score": 0.0, "jev_rank": 9, "kept": false, "reason": "low_on_target"}, {"rank": 8, "query_index": null, "title": "Cloudflare", "url": "https://www.advancesradonc.org/article/S2452-1094(23)00177-X/fulltext", "domain": "advancesradonc.org", "snippet": "Cloudflare is currently unable to resolve your requested domain (www.advancesradonc.org).", "date": null, "last_updated": "2025-11-03", "orig_rank": 8, "answers": {"on_target": 0.03, "evidence": 0.0}, "jev_score": 0.0, "jev_rank": 10, "kept": false, "reason": "low_on_target"}], "total_ms": 937.6, "ts": "2026-10-06T12:18:16+00:00"}
{"case_id": "q056-batch", "row_id": "q056", "mode": "batch", "objective": "MNPS Asset planned or expected data readouts, regulatory submissions, regulatory decisions, and expected timing in Head and Neck Cancer", "query": ["MNPS Asset first-line recurrent metastatic head and neck cancer data readout", "MNPS Asset head and neck cancer regulatory submission", "MNPS Asset head and neck cancer regulatory decision"], "anchors": ["MNPS"], "search_latency_ms": 561.1, "target": "MNPS", "ok": true, "error": null, "jev_latency_ms": 348.0, "calls": 10, "attempts": 10, "usage": {"input_tokens": 8045, "output_tokens": 360}, "cost_usd": 0.000338, "n_candidates": 10, "n_kept": 0, "abstain": true, "top_score": 0.3348, "results": [{"rank": 8, "query_index": null, "title": "Head & Neck Cancer | Clinical - CancerNetwork", "url": "https://www.cancernetwork.com/clinical/head-neck-cancer", "domain": "cancernetwork.com", "snippet": "The regulatory decision for subcutaneous amivantamab in recurrent/metastatic head and neck squamous cell carcinoma was based on phase 1b/2 OrigAMI-4 data.\n...\nThe safety profile of amivantamab was consistent with previous reports in this HNSCC population, with no new signals reported.\n...\nData from the BL-B01D1-301 study support iza-bren as a potential standard of care for pretreated recurrent or metastatic nasopharyngeal carcinoma.\n...\nThe investigator-evaluated ORR was 39.0% among those treated for recurrent/metastatic HNSCC, and the CR and PR rates were 9.8% and 29.3%, respectively.", "date": "2017-09-15", "last_updated": "2026-10-03", "orig_rank": 8, "answers": {"on_target": 0.41, "evidence": 0.8167}, "jev_score": 0.3348, "jev_rank": 1, "kept": false, "reason": "low_on_target"}, {"rank": 5, "query_index": null, "title": "Nasopharyngeal Carcinoma...", "url": "https://datalookout.com/head-neck-cancer-clinical-trials", "domain": "datalookout.com", "snippet": "The checkpoint immunotherapy era transformed recurrent/metastatic HNSCC: pembrolizumab (Keytruda) is FDA-approved as first-line monotherapy for high CPS scores and in combination with chemotherapy for all-comers; nivolumab (Opdivo) is approved in platinum-refractory disease.\n...\n|NCT06589804|Cetuximab + pembrolizumab vs pembrolizumab in 2L+ relapsed/metastatic HNSCC|National Cancer Institute (NCI)|Recruiting|\n...\n|NCT07026474|Re-chemoradiotherapy + pembrolizumab vs immunotherapy alone for locoregional recurrence (PD-L1 CPS≥1)|Universität des Saarlandes|Recruiting|\n...\nMerus subsequently launched two Phase 3 registrational trials covering the two most commercially significant HNSCC settings:\n- **LiGeR-HN1 (NCT06525220):** Petosemtamab + pembrolizumab vs pembrolizumab in first-line R/M HNSCC.\nThis is the pivotal trial for the 1L commercial indication, competing directly with pembrolizumab + chemotherapy standard of care.", "date": null, "last_updated": "2026-07-22", "orig_rank": 5, "answers": {"on_target": 0.44, "evidence": 0.7167}, "jev_score": 0.3153, "jev_rank": 2, "kept": false, "reason": "low_on_target"}, {"rank": 10, "query_index": null, "title": "Driving Progress in Recurrent and Metastatic Head and Neck Cancer", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13101959/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "The KEYNOTE-048 study^8^ established the use of pembrolizumab in the first-line setting, either as monotherapy (limited to patients with PD-L1 ≥ 1 expression) or in combination with platinum and 5-fluorouracil (5-FU).\nAs a result, immunotherapy was established as the core element of standard-of-care in the first-line treatment of platinum-sensitive R/M HNSCC.\nThe updated results from this study with a median follow-up of 45 months have shown an improved median OS in the pembrolizumab group compared to chemotherapy in the CPS ≥ 20 (14.9 vs 10.8 months; HR 0.61; 95% CI 0.46–0.81) and CPS ≥ 1 populations (12.3 vs 10.4 months; HR 0.74; 95% CI 0.61–0.89)^14^.\nAlso the combination of pembrolizumab-chemotherapy group compared to chemotherapy alone demonstrated a benefit in median OS in the PD-L1 CPS ≥ 20 (14.7 vs 11.1 months; HR 0.62; 95% CI 0.46–0.84), CPS ≥ 1 (13.6 vs 10.6 months;\n...\nThe phase 4 study KEYNOTE-B10^15^ was a non-randomized, single arm study with ORR reaching 49% in the overall population.\nDespite the inherent differences between real-world populations and clinical trial cohorts, pembrolizumab-based regimens have shown comparable OS results in the real-world population to previously demonstrated in the KEYNOTE-048 trial^16,17^.\n...\nDespite biological^10^ and technical limitations, PD-L1 remains a dominant factor to guiding first-line treatment decision.\nTumor heterogeneity, including intrapatient variability across primary and metastatic sites, and fixed cutoff thresholds challenges its reproducibility and standardization across studies and clinical settings.\n...\nRetrospective analyses have demonstrated no statistically significant difference in survival outcomes between patients who discontinued versus continued immune checkpoint inhibitor therapy at one- or two-year timepoints^55^.\n...\nPreliminary results demonstrated an ORR of around 32% in the first-line setting for patients with PD-L1 CPS ≥1^58^.\n...\nUndetectable ctDNA levels following an initial response may help identify patients in whom treatment can be safely de-escalated or discontinued, while persistent ctDNA may indicate the need for continued therapy.\n...\nImmune checkpoint blockade with different agents such as nivolumab, pembrolizumab or toripalimab paired with EGFR inhibitors have demonstrated overall response rates (ORR) ranging from 30% to 55% in immune-naïve populations^86,87,88,89^.\n...\nPetosentamab (MCLA-158), a bispecific antibody that targets the epidermal growth factor receptor (EGFR) and the leucine-rich repeat containing G-protein-coupled receptor 5 (LGR5), currently holds two breakthrough therapy designations by the FDA for patients with R/M HNSCC who have experienced disease progression following treatment with platinum-based chemotherapy and a PD-L1/PD-1 inhibitor^91^ and also in the first-line setting in combination with pembrolizumab for patients with PD-L1 (CPS≥1)^92^.\nThe combination of petosentamab with pembrolizumab continues to be investigated in the front-line setting (NCT03526835).\nPreliminary results have shown ORR of 60% (50% for p16+ and 66% for p16-HNSCC).\n...\nBCA101 in combination with pembrolizumab in R/M HNSCC for patients who had received no previous systemic therapy in the R/M disease setting showed ORR of 46% in the whole population and 57% in th HPV- subgroup^93,94^.\nThe phase II/III FORTIFI-HN01 study (NCT06788990) is currently evaluating the combination of pembrolizumab with ficerafusp alfa (BCA101) vs placebo in the first-line setting for PD-L1-positive R/M HNSCC^95^.\n...\nPrevious data suggest that second-line treatment should be considered after IO progression in patients with HNSCC, even in cases with poor PS^98^.\n...\nNo new data were generated or analyzed for this review article.", "date": "2026-07-01", "last_updated": "2026-09-30", "orig_rank": 10, "answers": {"on_target": 0.3, "evidence": 0.32}, "jev_score": 0.096, "jev_rank": 3, "kept": false, "reason": "low_on_target"}, {"rank": 7, "query_index": null, "title": "First-Line Therapy in Recurrent or Metastatic Head and Neck Squamous Cell Carcinoma: A Retrospective, Multicenter, Real-World Study", "url": "https://onlinelibrary.wiley.com/doi/full/10.1002/hed.28211", "domain": "onlinelibrary.wiley.com", "snippet": "# First-Line Therapy in Recurrent or Metastatic Head and Neck Squamous Cell Carcinoma: A Retrospective, Multicenter, Real-World Study\n...\nIn Europe, pembrolizumab with or without chemotherapy is the recommended first-line treatment for recurrent or metastatic head and neck squamous cell carcinoma (R/M HNSCC), with a combined positive score (CPS) ≥ 1.\nIn France, the TPExtreme (TPEx) regimen is preferred for CPS < 1.\n...\nWe reviewed all R/M HNSCC cases treated with first-line regimens between January 2021 and December 2023 in Nancy and Lille.\nData on patient history, treatments, survival, response, and safety were collected.\n...\nThe analysis included 290 patients; 19% received pembrolizumab alone, 28% received pembrolizumab with chemotherapy, 19% received TPEx, and 20% received adapted regimens.\nPFS and OS differed significantly between groups.\nMedian PFS and OS were respectively 2.9 and 9.4 months for pembrolizumab, 6 and 15.5 months for pembrolizumab-chemotherapy, 5.9 and 13.7 months for TPEx, and 4.3 and 10 months for adapted regimens.\nPembrolizumab alone is the safest regimen.\n...\nThis retrospective study reflects real-world first-line therapy for R/M HNSCC in two French cancer institutes.\nPembrolizumab combined with chemotherapy is the preferred treatment option.\n...\nHistorically, the first-line treatment for recurrent or metastatic head and neck squamous cell carcinoma (R/M HNSCC) has been chemotherapy alone.\n...\nThe European Society for Medical Oncology (ESMO) recommends [9] the use of pembrolizumab for patients with a CPS ≥ 1, potentially associated with chemotherapy, and the EXTREME or TPEx regimens for patients with a CPS < 1.\nThese recommendations apply only to patients in good health condition.\n...\nThis retrospective, multicentric study included patients treated for R/M HNSCC from January 1st 2021 to December 31th 2023, in Nancy (ICL) and Lille (COL).\n...\nBetween January 1, 2021 and December 31, 2023, 290 patients treated for R/M HNSCC were included: 157 (54%) in ICL and 133 (46%) in COL.\n...\nORR was 18% in the pembrolizumab group (10 patients, with 1 complete response at 2–12 months), 57.5% in the pembrolizumab-chemotherapy group (46 patients, with 1 complete response at 2–12 months), 59% in the TPEx group (33 patients), and 39% in the adapted regimens group (23 patients, 2 complete responses at 2 and 4 months).\n...\nPFS differed significantly between groups, with a median PFS of 2.9 months [95% CI 2.1–3.7] for pembrolizumab, 6 [4.7–7.4] for pembrolizumab-chemotherapy, 5.9 [4.3–7.4] for TPEx, and 4.3 [3.2–5.4] for adapted regimens (Figure 1).\n...\nPembrolizumab, alone or in combination with chemotherapy, is favored for patients with a CPS ≥ 1, while the TPEx regimen remains common for patients with a CPS < 1.", "date": "2025-11-01", "last_updated": "2026-10-01", "orig_rank": 7, "answers": {"on_target": 0.18, "evidence": 0.3233}, "jev_score": 0.0582, "jev_rank": 4, "kept": false, "reason": "low_on_target"}, {"rank": 3, "query_index": null, "title": "Live Head And Neck Cancer updates", "url": "https://www.miragenews.com/tag/head-and-neck-cancer/", "domain": "miragenews.com", "snippet": "Live Head And Neck Cancer news coverage of developments with the latest updates.", "date": "2026-10-02", "last_updated": "2026-10-02", "orig_rank": 3, "answers": {"on_target": 0.11, "evidence": 0.04}, "jev_score": 0.0044, "jev_rank": 5, "kept": false, "reason": "low_on_target"}, {"rank": 6, "query_index": null, "title": "[PDF] 2022 Update edited by the Japan Society for Head and Neck Cancer", "url": "https://www.sciencedirect.com/science/article/am/pii/S0385814623001402", "domain": "sciencedirect.com", "snippet": "If you are unable to access your content please\ntry accessing the content again or\ncontact our support team", "date": null, "last_updated": "2025-09-02", "orig_rank": 6, "answers": {"on_target": 0.06, "evidence": 0.0167}, "jev_score": 0.001, "jev_rank": 6, "kept": false, "reason": "low_on_target"}, {"rank": 2, "query_index": null, "title": "Search Page - Drug and Health Product Register", "url": "https://hpr-rps.hres.ca/reg-content/regulatory-decision-summary.php", "domain": "hpr-rps.hres.ca", "snippet": "## Regulatory Decision Summary Search\nAll Regulatory Decision Summaries\n- **Date modified:**\n2016-04-13", "date": "2014-10-23", "last_updated": "2026-10-02", "orig_rank": 2, "answers": {"on_target": 0.09, "evidence": 0.0067}, "jev_score": 0.00