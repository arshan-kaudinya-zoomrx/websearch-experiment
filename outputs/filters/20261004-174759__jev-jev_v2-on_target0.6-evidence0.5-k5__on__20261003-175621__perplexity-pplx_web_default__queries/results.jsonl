{"case_id": "q037-4", "row_id": "q037", "mode": "queries", "objective": "IPS-06061 in vivo single-agent monotherapy tumour growth inhibition TGI tumour regression tumour shrinkage in KRAS G12D Mutant Pancreatic Ductal Adenocarcinoma animal models", "query": "IPS-06061 tumour shrinkage pancreatic cancer xenograft", "anchors": ["IPS-06061"], "search_latency_ms": 7610.0, "target": "IPS-06061", "ok": true, "error": null, "jev_latency_ms": 322.6, "calls": 10, "attempts": 10, "usage": {"input_tokens": 8060, "output_tokens": 360}, "cost_usd": 0.000339, "n_candidates": 10, "n_kept": 3, "abstain": false, "top_score": 0.6499, "results": [{"rank": 1, "query_index": null, "title": "IPS-06061, a novel orally active TPD molecular glue degrader targeting… | Gagan Kukreja | 10 comments", "url": "https://www.linkedin.com/posts/kukreja3_ips-06061-a-novel-orally-active-tpd-molecular-activity-7323060772941504513-JGc2", "domain": "linkedin.com", "snippet": "IPS-06061, a novel orally active TPD molecular glue degrader targeting KRAS G12D shows strong anti-tumor efficacy using a xenograft animal model Discovered using IPS's cutting-edge ProGlu AI-based drug discovery platform that accurately predicts PPI between E3 ligase and KRAS G12D through MD simulation, enabling de novo design of MG degraders and PPIExplorer, an IPS-Chip based Proteomics technology https://lnkd.in/gyuut7Re https://lnkd.in/g2PZ_vD6", "date": "2025-04-29", "last_updated": "2025-05-01", "orig_rank": 1, "answers": {"on_target": 0.97, "evidence": 0.67}, "jev_score": 0.6499, "jev_rank": 1, "kept": true, "reason": "kept"}, {"rank": 3, "query_index": null, "title": "Degradation inducer", "url": "https://www.bioworld.com/articles/topic/570?page=24", "domain": "bioworld.com", "snippet": "## IPS-06061: a molecular glue degrader of KRAS G12D with in vivo efficacy", "date": "2026-09-20", "last_updated": "2026-09-20", "orig_rank": 3, "answers": {"on_target": 0.98, "evidence": 0.6467}, "jev_score": 0.6338, "jev_rank": 2, "kept": tr