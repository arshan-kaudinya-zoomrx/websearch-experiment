{"case_id": "q034-1", "row_id": "q034", "mode": "queries", "objective": "Compound 18l first regulatory approval or market launch year for acute myeloid leukemia", "query": "Compound 18l ALKBH5 AML regulatory approval launch year", "anchors": ["Compound 18l"], "search_latency_ms": 682.5, "target": "Compound 18l", "ok": true, "error": null, "jev_latency_ms": 347.8, "calls": 10, "attempts": 10, "usage": {"input_tokens": 7140, "output_tokens": 360}, "cost_usd": 0.0003, "n_candidates": 10, "n_kept": 3, "abstain": false, "top_score": 0.5152, "results": [{"rank": 9, "query_index": null, "title": "Decoding the immunoregulatory functions of ALKBH5 in ...", "url": "https://www.frontiersin.org/journals/immunology/articles/10.3389/fimmu.2025.1709260/full", "domain": "frontiersin.org", "snippet": "Additionally, a series of maleimide derivatives targeting the noncatalytic C200 site were developed; compound 18l exhibited potent inhibitory activity (IC~50~ = 0.62 μM), robust anti-leukemic effects, and achieved a 66.3% tumor inhibition rate in NB4 xenograft models (65).", "date": "2026-01-05", "last_updated": "2026-01-17", "orig_rank": 9, "answers": {"on_target": 0.84, "evidence": 0.6133}, "jev_score": 0.5152, "jev_rank": 1, "kept": true, "reason": "kept"}, {"rank": 4, "query_index": null, "title": "Chinese Academy of Sciences Shanghai Branch", "url": "http://english.shb.cas.cn/rh/rp/202503/t20250311_903636.html", "domain": "english.shb.cas.cn", "snippet": "At doses of 1 mg/kg and 2.5 mg/kg, 18l effectively inhibited tumor growth, achieving tumor inhibition rates of 66.3% and 76.8%, respectively, without observable adverse effects, demonstrating efficacy and safety in vivo.", "date": "2025-03-11", "last_updated": "2025-05-08", "orig_rank": 4, "answers": {"on_target": 0.84, "evidence": 0.5933}, "jev_score": 0.4984, "jev_rank": 2, "kept": true, "reason": "kept"}, {"rank": 8, "query_index": null, "title": "Discovery of Covalent and Cell‐Active ALKBH5 Inhibitors with ...", "url": "https