ore": 0.0, "jev_rank": 9, "kept": false, "reason": "low_on_target"}, {"rank": 7, "query_index": null, "title": "Bimini Biotech | Longevity Solutions", "url": "https://bimini-biotech.com/", "domain": "bimini-biotech.com", "snippet": "Email info@bimini-biotech.com LinkedIn linkedin.com/in/fxpellay", "date": null, "last_updated": "2026-09-23", "orig_rank": 7, "answers": {"on_target": 0.06, "evidence": 0.0}, "jev_score": 0.0, "jev_rank": 10, "kept": false, "reason": "low_on_target"}], "total_ms": 1581.3, "ts": "2026-10-04T12:16:24+00:00"}
{"case_id": "q026-3", "row_id": "q026", "mode": "queries", "objective": "BM-013 first regulatory approval or market launch year in acute myeloid leukemia", "query": "BM-013 WASP AML clinical development forecast", "anchors": ["BM-013"], "search_latency_ms": 1074.7, "target": "BM-013", "ok": true, "error": null, "jev_latency_ms": 380.3, "calls": 10, "attempts": 10, "usage": {"input_tokens": 7464, "output_tokens": 360}, "cost_usd": 0.000313, "n_candidates": 10, "n_kept": 2, "abstain": false, "top_score": 0.736, "results": [{"rank": 1, "query_index": null, "title": "Portfolio - BIMINI Biotech", "url": "https://biminibiotech.nl/technology-2/", "domain": "biminibiotech.nl", "snippet": "BIMINI Biotech is a preclinical stage company developing novel first-in-class small molecule therapeutics in oncology with a focus on lymphomas and leukemia, malignancies with a strong unmet need.\n...\nOur approach has shown promising *in vitro* and *in vivo* results.\n...\nOur WASp inhibitor (BM-013) downregulates the WASp concentration and function by enhancing degradation of the protein, thereby inhibiting the proliferation specifically of leukemic cells.\nTarget indications include Acute myeloid leukemia (AML) and T-Cell Lymphoblastic Leukemia (T-ALL).", "date": "2025-01-01", "last_updated": "2025-09-15", "orig_rank": 1, "answers": {"on_target": 0.96, "evidence": 0.7667}, "jev_score": 0.736, "jev_rank": 1, "kept": true, "reason": "kept"}, {"rank": 3, "query_index": null, "title": "Targeting multiple signaling pathways: the new approach to acute myeloid leukemia therapy", "url": "https://www.nature.com/articles/s41392-020-00361-x", "domain": "nature.com", "snippet": "In October of 2019, bemcentinib received fast-track designation from the FDA for the treatment of elderly patients with R/R AML based on unpublished data supporting its efficacy in phase II trial (NCT03824080).", "date": "2020-12-18", "last_updated": "2020-12-18", "orig_rank": 3, "answers": {"on_target": 0.83, "evidence": 0.7867}, "jev_score": 0.653, "jev_rank": 2, "kept": true, "reason": "kept"}, {"rank": 9, "query_index": null, "title": "BIMINI Biotech", "url": "https://biobase.whitefordresearch.com/companies/bimini-biotech", "domain": "biobase.whitefordresearch.com", "snippet": "BIMINI Biotech is a preclinical-stage therapeutics company based in Leiden, The Netherlands, developing first-in-class small-molecule drugs for oncology and autoimmune disease by targeting the Wiskott-Aldrich Syndrome protein (WASp).\n...\nIts public materials describe the company as advancing lead programs toward first-in-human studies, with current work centered on translational preclinical development and patient-stratification biomarkers.\n...\nThe company's lead emphasis is oncology, particularly aggressive hematological cancers including lymphomas, leukemias, mantle cell lymphoma, and acute myeloid leukemia (AML).\nIn 2026, BIMINI announced the MYELO-WASP Eurostars project, a EUR 2.2 million international consortium intended to complete translational preclinical development of proprietary WASp modulators for myeloid and lymphoid leukemias and generate a preclinical package for CTA-enabling studies and first-in-human trials.\nIt also announced a Health~Holland-backed AML-WASP collaboration with a EUR 440,000 budget to optimize small-molecule WASp activators, validate activity in relapse/refractory AML models, and identify predictive biomarkers for patient stratification.", "date": null, "last_updated": "2026-09-15", "orig_rank": 9, "answers": {"on_target": 0.13, "evidence": 0.6}, "jev_score": 0.078, "jev_rank": 3, "kept": false, "reason": "low_on_target"}, {"rank": 6, "query_index": null, "title": "Acute Myeloid Leukemia: 2025 Update on Diagnosis, Risk-Stratification, and Management", "url": "https://onlinelibrary.wiley.com/doi/full/10.1002/ajh.27625", "domain": "onlinelibrary.wiley.com", "snippet": "Alongside revumenib, a multitude of different menin inhibitors are currently in various stages of clinical trial development either as monotherapy or in combination with chemotherapy or HMA + venetoclax.\nThese include ziftomenib, bleximenib [236], BMF-219, DS1594 and DSP 5336.", "date": "2025-05-01", "last_updated": "2026-10-03", "orig_rank": 6, "answers": {"on_target": 0.17, "evidence": 0.34}, "jev_score": 0.0578, "jev_rank": 4, "kept": false, "reason": "low_on_target"}, {"rank": 5, "query_index": null, "title": "Frontiers | From monoclonals to bispecific T cell engagers: the evolving antibody-based therapy landscape in acute myeloid leukemia", "url": "https://www.frontiersin.org/journals/immunology/articles/10.3389/fimmu.2026.1803185/full", "domain": "frontiersin.org", "snippet": "Currently, a phase-I clinical trial is evaluating the combination of flotetuzumab, a CD3xCD123 BTCE, with MGA012, an anti-PD-1 inhibitor, in patients with R/R AML (222).", "date": "2026-06-01", "last_updated": "2026-10-03", "orig_rank": 5, "answers": {"on_target": 0.13, "evidence": 0.3933}, "jev_score": 0.0511, "jev_rank": 5, "kept": false, "reason": "low_on_target"}, {"rank": 10, "query_index": null, "title": "Location First: Targeting Acute Myeloid Leukemia Within Its Niche", "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7290711/", "domain": "ncbi.nlm.nih.gov", "snippet": "Although clinical translation of these approaches targeting AML cell adhesion within the BM niche is still in its infancy, emerging early phase clinical data indicate this approach may be beneficial in the adjuvant setting, boosting the effects of conventional treatments.", "date": null, "last_updated": "2026-01-18", "orig_rank": 10, "answers": {"on_target": 0.12, "evidence": 0.3733}, "jev_score": 0.0448, "jev_rank": 6, "kept": false, "reason": "low_on_target"}, {"rank": 8, "query_index": null, "title": "Decoding Leukemic Stem Cells in AML: From Identification to ...", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12939826/", "domain": "pmc.ncbi.nlm.nih.gov", "snippet": "|Menin inhibitors|Enzomenib, Bleximenib, DS-1954, BMF-219|Menin-KMT2A interaction|LSCs in KMT2A-r/NPM1-mutated AML|Phase I/II clinical trials|\n...\nBeyond approved agents, several additional menin inhibitors (e.g., enzomenib, bleximenib, DS-1954, BMF-219) are under clinical evaluation as monotherapy and in combinations (e.g., venetoclax-based regimens, FLT3 inhibitors, HMAs, and intensive chemotherapy).", "date": "2026-01-30", "last_updated": "2026-08-25", "orig_rank": 8, "answers": {"on_target": 0.11, "evidence": 0.3767}, "jev_score": 0.0414, "jev_rank": 7, "kept": false, "reason": "low_on_target"}, {"rank": 2, "query_index": null, "title": "CLINICAL TRIALS", "url": "https://www.amgentrials.com/study/?id=MT103-104", "domain": "amgentrials.com", "snippet": "## CLINICAL TRIALS\n...\n© 1996–2024 Amgen Inc.", "date": "1996-01-01", "last_updated": "2025-05-02", "orig_rank": 2, "answers": {"on_target": 0.27, "evidence": 0.07}, "jev_score": 0.0189, "jev_rank": 8, "kept": false, "reason": "low_on_target"}, {"rank": 7, "query_index": null, "title": "VU Research Portal", "url": "https://research.vu.nl/ws/files/138247870/D%20G%20J%20%20Cucchi%20-%20thesis.pdf", "domain": "research.vu.nl", "snippet": "Twenty-eight agents were steered towards phase III, after three phase II trials on average.", "date": null, "last_updated": "2025-03-06", "orig_rank": 7, "answers": {"on_target": 0.07, "evidence": 0.1933}, "jev_score": 0.0135, "jev_rank": 9, "kept": false, "reason": "low_on_target"}, {"rank": 4, "query_index": null, "title": "Acute myeloid leukemia (AML)", "url": "https://www.onkopedia.com/en/onkopedia/guidelines/acute-myeloid-leukemia-aml/@@guideline/html/index.html", "domain": "onkopedia.com", "snippet": "Patients with a higher risk of recurrence should receive allogeneic stem cell transplantation as post-remission therapy if possible.", "date": "2026-05-18", "last_updated": "2026-10-02", "orig_rank": 4, "answers": {"on_target": 0.03, "evidence": 0.2767}, "jev_score": 0.0083, "jev_rank": 10, "kept": false, "rea