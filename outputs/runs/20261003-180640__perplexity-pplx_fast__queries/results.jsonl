{"row_id": "q048", "objective": "dCASP1-55 first regulatory approval or market launch year in acute myeloid leukemia", "anchors": ["dCASP1-55"], "mode": "queries", "case_id": "q048-3", "query": "dCASP1-55 University of Cincinnati AML clinical development", "repeat": 0, "provider": "perplexity", "request": {"query": "dCASP1-55 University of Cincinnati AML clinical development", "search_type": "fast", "max_results": 10}, "ok": true, "status": 200, "error": null, "attempts": 1, "latency_ms": 408.4, "n_results": 10, "results": [{"rank": 1, "query_index": null, "title": "Clinical Trials - College of Medicine - University of Cincinnati", "url": "https://med.uc.edu/research/clinicaltrials?strDept=All&query=&page=13", "domain": "med.uc.edu", "snippet": "A Phase 1b Study of Menin Inhibitor SNDX-5613 in Combination with Daunorubicin and Cytarabine in Newly Diagnosed Patients with Acute Myeloid Leukemia and NPM1 Mutated/FLT3 Wildtype with Higher-Risk Features or MLL/KMT2A Rearranged Disease.\nThis phase Ib trial evaluates the safety, side effects, and optimal dosage of SNDX-5613 in combination with standard chemotherapy (daunorubicin and cytarabine) for patients with newly diagnosed acute myeloid leukemia (AML) harboring NPM1 or MLL/KMT2A gene mutations.", "date": null, "last_updated": "2026-10-02"}, {"rank": 2, "query_index": null, "title": "UC hematology experts present research at national conference", "url": "https://www.uc.edu/news/articles/2023/12/uc-hematology-experts-present-research-at-national-conference.html", "domain": "uc.edu", "snippet": "IRAK4 is a protein known to help drive growth of acute myeloid leukemia (AML) cells through overactivation, making it a potential target for new treatments.\n...\nThey found one compound was especially effective at killing AML cells by reducing the levels of a different protein called c-myc that drives cancer growth.\n...\nMany drugs have been developed to target c-myc without much clinical success, so Vick said moving forward the team will test the use of this class of drugs with IRAK4 inhibitors as an alternative approach to target leukemia.\n...\nThe research team tested a new compound in the lab and found it works “very well” against the gatekeeper mutation and shows promise as a treatment that could help lead to long-term survival for patients with AML.\nA Phase 1 clinical trial in healthy volunteers is currently underway to determine the best dose of the treatment in humans, Elgamal said.", "date": "2023-12-08", "last_updated": "2025-10-01"}, {"rank": 3, "query_index": null, "title": "Multi-institutional team awarded NCI grant to open novel AML trial", "url": "https://www.uc.edu/news/articles/2025/06/multi-institutional-team-awarded-nci-grant-to-open-novel-aml-trial.html", "domain": "uc.edu", "snippet": "The Phase 1 clinical study in AML will open at UC and OSU in 2026.", "date": "2025-06-23", "last_updated": "2026-09-18"}, {"rank": 4, "query_index": null, "title": "AML, sickle cell disease research among highlights of UC ASH abstracts", "url": "https://www.eurekalert.org/news-releases/1067056", "domain": "eurekalert.org", "snippet": "A randomized Phase 1 trial in healthy volunteers found a new drug targeting treatment-resistant acute myeloid leukemia (AML) is safe and attains drug levels that would predict response in this disease.", "date": "2024-01-01", "last_updated": "2025-01-28"}, {"rank": 5, "query_index": null, "title": "ScienceDaily: Search Archives", "url": "https://www.sciencedaily.com/search/", "domain": "sciencedaily.com", "snippet": "ScienceDaily: Search Archives\n# Search Archives\nOctober 3, 2026", "date": "2026-10-03", "last_updated": "2026-10-03"}, {"rank": 6, "query_index": null, "title": "guce", "url": "https://finance.yahoo.com/sectors/healthcare/articles/cnty-813-preclinical-data-demonstrate-200500648.html", "domain": "finance.yahoo.com", "snippet": "This data is collected in aggregate and is not tied to specific users.measure your use of our sites and apps", "d